{
  "name": "plupack-react-3d",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run models:check-imports && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "models:inspect": "node scripts/optimize-models.mjs --inspect",
    "models:optimize": "node scripts/optimize-models.mjs",
    "models:report": "node scripts/optimize-models.mjs --report",
    "models:check-imports": "node scripts/check-model-imports.mjs"
  },
  "dependencies": {
    "@pmndrs/assets": "^1.0.12",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@tailwindcss/vite": "^4.1.17",
    "gsap": "^3.13.0",
    "lenis": "^1.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suspend-react": "^0.1.3",
    "tailwindcss": "^4.1.17",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }

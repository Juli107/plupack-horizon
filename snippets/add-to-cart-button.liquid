{%- doc -%}
  Renders a "Contact us to quote" link instead of add-to-cart.
  Original add-to-cart functionality is disabled store-wide.
{%- enddoc -%}

<a
  href="/pages/contacto"
  class="button {{ class }}"
  style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; width: 100%;"
>
  <span>Contactanos para cotizar</span>
</a>

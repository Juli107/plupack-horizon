<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="{{ 'favicon-32x32.png' | asset_url }}"
    >
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="{{ 'favicon-16x16.png' | asset_url }}"
    >
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="{{ 'apple-touch-icon.png' | asset_url }}"
    >

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style>
      /* ===== HIDE ALL PRICES STORE-WIDE ===== */
      product-price,
      .price,
      .compare-at-price,
      .unit-price,
      .cart-items__price,
      .cart-items__price-unit,
      .cart__summary-totals,
      .cart__original-total,
      .cart__total,
      .cart__original-total-value,
      .cart__total-value,
      price-facet-component,
      .price-facet,
      .collection-search-item__price {
        display: none !important;
      }

      /* ===== ALIGN PRODUCT CARD BUTTONS TO BOTTOM ===== */
      .product-card__content {
        height: 100%;
      }

      .product-card__content .buy-buttons-block {
        margin-top: auto;
      }



      /* ===== STICKY HEADER + ANNOUNCEMENT BAR ===== */

      /* Non-homepage: make header group a single sticky block */
      body:not(:has(.react-homepage)) #header-group:has(#header-component[sticky]) {
        display: block !important;
        position: sticky;
        top: -1px;
        z-index: var(--layer-sticky);
      }

      body:not(:has(.react-homepage)) #header-group:has(#header-component[sticky]) .header-section {
        position: relative !important;
      }

      body:not(:has(.react-homepage)) #header-group > * {
        margin: 0 !important;
      }

      body:not(:has(.react-homepage)) #header-group .header__row {
        border-bottom: none !important;
      }

      body:not(:has(.react-homepage)) #header-group > *:last-child {
        margin-top: -1px !important;
      }

      /* Homepage: announcement bar sticks independently below header */
      body:has(.react-homepage) .shopify-section-group-header-group:has(.announcement-bar) {
        position: sticky;
        top: calc(var(--header-height, 60px) - 1px);
        z-index: calc(var(--layer-sticky) - 1);
      }

      /* Homepage: blue header at top, transparent when scrolling */
      body:has(.react-homepage) #header-component[transparent]:not([data-sticky-state='active']) .header__row {
        --header-bg-color: #084e85 !important;
      }

      body:has(.react-homepage) #header-component[transparent][data-sticky-state='active'] .header__row {
        --header-bg-color: transparent !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{% unless request.page_type == 'index' or request.path contains '/pages/nosotros' %} page-bg-soft{% endunless %}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      style="{% if request.page_type == 'collection' or request.page_type == 'product' %}min-height: 100vh;{% elsif request.page_type == 'page' and template.suffix == 'contact' %}min-height: 70vh;{% endif %}"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>

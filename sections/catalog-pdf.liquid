<div
  class="section section--page-width spacing-style"
  style="--padding-block-start: 0px; --padding-block-end: 16px;"
>
  {% if section.settings.catalog_pdf_url != blank %}
    <p style="margin: 0;">
      <a
        href="{{ section.settings.catalog_pdf_url }}"
        target="_blank"
        style="text-decoration: underline; font-family: var(--font-body--family); font-size: 0.95rem; color: var(--color-foreground-heading);"
      >
        Descargar catálogo de productos (PDF)
      </a>
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Catálogo PDF",
  "settings": [
    {
      "type": "url",
      "id": "catalog_pdf_url",
      "label": "URL catálogo PDF"
    }
  ],
  "presets": [
    {
      "name": "Catálogo PDF"
    }
  ]
}
{% endschema %}

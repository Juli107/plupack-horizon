<div
  class="section section--page-width spacing-style"
  style="--padding-block-start: 0px; --padding-block-end: 16px;"
>
  {% if section.settings.catalog_pdf_url != blank %}
    <a
      href="{{ section.settings.catalog_pdf_url }}"
      target="_blank"
      style="display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: underline; font-family: var(--font-body--family); font-size: 0.95rem; color: var(--color-foreground-heading);"
    >
      Descargar catálogo de productos (PDF)
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Catálogo PDF",
  "settings": [
    {
      "type": "url",
      "id": "catalog_pdf_url",
      "label": "URL catálogo PDF",
      "default": "https://cdn.shopify.com/s/files/1/0710/1834/8589/files/Catalogo_de_PLUPack_Embalajes.pdf?v=1777043455"
    }
  ],
  "presets": [
    {
      "name": "Catálogo PDF"
    }
  ]
}
{% endschema %}

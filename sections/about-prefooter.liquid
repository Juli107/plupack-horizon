<section
  id="about-prefooter-{{ section.id }}"
  class="about-prefooter"
  style="
    --prefooter-bg-start: {{ settings.about_page_bg_alt }};
    --prefooter-text: {{ settings.about_page_text }};
    --prefooter-line: {{ settings.about_page_line }};
    --prefooter-button-bg: {{ settings.about_page_button_bg }};
    --prefooter-button-text: {{ settings.about_page_button_text }};
  "
>
  <div class="about-prefooter__backdrop" aria-hidden="true"></div>

  <div class="about-prefooter__inner">
    <h2 class="about-prefooter__title" data-reveal style="--reveal-delay: 0.06s;">
      <span>{{ section.settings.heading_line_1 }}</span>
      <span class="about-prefooter__title-subline">{{ section.settings.heading_line_2 }}</span>
    </h2>

    <div class="about-prefooter__actions" data-reveal style="--reveal-delay: 0.16s;">
      <a
        href="{{ section.settings.primary_cta_url | default: '/collections/all' }}"
        class="about-prefooter__btn about-prefooter__btn--solid"
      >
        {{ section.settings.primary_cta_label }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-prefooter {
    position: relative;
    z-index: 20;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 90vh;
    padding: 5rem 1.5rem;
    background: var(--prefooter-bg-start);
    isolation: isolate;
  }

  .about-prefooter__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--prefooter-bg-start) 74%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .about-prefooter__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 1100px;
    color: var(--prefooter-text);
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .about-prefooter__title {
    margin: 0;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(2.8rem, 7vw, 5.625rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    font-weight: 700;
  }

  .about-prefooter__title span {
    display: block;
    color: var(--prefooter-text);
  }

  .about-prefooter__title-subline {
    font-family: var(--font-heading--family), sans-serif;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--prefooter-text) 70%, transparent);
  }

  .about-prefooter__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
  }

  .about-prefooter__btn {
    min-width: 220px;
    min-height: 48px;
    padding: 0.75rem 2.5rem;
    border-radius: 10px;
    border: 1px solid var(--prefooter-line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    transition: background-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .about-prefooter__btn--solid {
    background: var(--prefooter-button-bg);
    color: var(--prefooter-button-text);
    border-color: var(--prefooter-button-bg);
  }

  .about-prefooter__btn--ghost {
    background: transparent;
    color: var(--prefooter-text);
  }

  .about-prefooter__btn:hover {
    background: color-mix(in srgb, var(--prefooter-text) 8%, transparent);
    color: var(--prefooter-text);
  }

  .about-prefooter__btn--solid:hover {
    background: color-mix(in srgb, var(--prefooter-button-bg) 90%, var(--prefooter-text) 10%);
    color: var(--prefooter-button-text);
  }

  .about-prefooter__btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--prefooter-text) 90%, transparent);
    outline-offset: 3px;
  }

  .about-prefooter__btn:active {
    transform: translateY(1px);
  }

  .about-prefooter [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: prefooter-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes prefooter-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  @media (max-width: 989px) {
    .about-prefooter {
      min-height: 72vh;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .about-prefooter__title {
      font-size: clamp(2.5rem, 11vw, 4.75rem);
      line-height: 1;
    }

    .about-prefooter__title span {
      font-size: inherit;
    }

    .about-prefooter__btn {
      width: min(340px, 100%);
      min-width: 0;
    }
  }

  @media (min-width: 640px) {
    .about-prefooter__actions {
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-prefooter [data-reveal] {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .about-prefooter__btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Prefooter",
  "tag": "section",
  "class": "about-prefooter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Embalajes"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "SIN LÍMITES"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "VER PRODUCTOS"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button URL"
    }
  ],
  "presets": [
    {
      "name": "About Prefooter"
    }
  ]
}
{% endschema %}

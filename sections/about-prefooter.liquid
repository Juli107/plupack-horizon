{% assign heading_line_2_upcase = section.settings.heading_line_2 | upcase %}

<section
  id="about-prefooter-{{ section.id }}"
  class="about-prefooter"
  style="
    --prefooter-bg-start: {{ section.settings.background_start }};
    --prefooter-bg-end: {{ section.settings.background_end }};
    --prefooter-text: {{ section.settings.text_color }};
  "
>
  <div class="about-prefooter__overlay" aria-hidden="true"></div>
  <div class="about-prefooter__orbital" aria-hidden="true">
    <span class="about-prefooter__bubble about-prefooter__bubble--a"></span>
    <span class="about-prefooter__bubble about-prefooter__bubble--b"></span>
    <span class="about-prefooter__bubble about-prefooter__bubble--c"></span>
    <span class="about-prefooter__bubble about-prefooter__bubble--d"></span>
  </div>
  <div class="about-prefooter__grain" aria-hidden="true"></div>
  <div class="about-prefooter__ambient-glow" aria-hidden="true"></div>

  <div class="about-prefooter__inner">
    <h2 class="about-prefooter__title" data-reveal style="--reveal-delay: 0.06s;">
      <span>{{ section.settings.heading_line_1 }}</span>
      <span class="about-prefooter__outline-wrap">
        <span class="about-prefooter__outline-sizer" aria-hidden="true">{{ heading_line_2_upcase }}</span>
        <svg class="about-prefooter__outline-svg" viewBox="0 0 1000 160" preserveAspectRatio="xMinYMid meet" aria-hidden="true" focusable="false">
          <defs>
            <filter id="prefooter-outline-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
              <feMorphology in="SourceAlpha" result="DILATED" operator="dilate" radius="2.8" />
              <feComposite in="DILATED" in2="SourceAlpha" operator="out" result="OUTLINE" />
              <feFlood flood-color="rgba(234, 244, 250, 0.96)" result="COLOR" />
              <feComposite in="COLOR" in2="OUTLINE" operator="in" result="FINAL" />
            </filter>
          </defs>
          <text class="about-prefooter__outline-text" x="0" y="125" style="filter: url(#prefooter-outline-{{ section.id }});">
            {{ heading_line_2_upcase }}
          </text>
        </svg>
      </span>
    </h2>

    <div class="about-prefooter__actions" data-reveal style="--reveal-delay: 0.16s;">
      <a
        href="{{ section.settings.primary_cta_url | default: '/pages/cotizar' }}"
        class="about-prefooter__btn about-prefooter__btn--solid"
      >
        {{ section.settings.primary_cta_label }}
      </a>
      <a
        href="{{ section.settings.secondary_cta_url | default: '/collections/all' }}"
        class="about-prefooter__btn about-prefooter__btn--ghost"
      >
        {{ section.settings.secondary_cta_label }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-prefooter {
    position: relative;
    z-index: 20;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 90vh;
    padding: 5rem 1.5rem;
    background:
      radial-gradient(88% 112% at 50% 8%, rgba(183, 239, 255, 0.24) 0%, rgba(30, 67, 119, 0) 54%),
      linear-gradient(165deg, var(--prefooter-bg-start) 0%, var(--prefooter-bg-end) 100%);
    isolation: isolate;
  }

  .about-prefooter__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: rgba(20, 108, 144, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .about-prefooter__orbital {
    position: absolute;
    top: -10%;
    right: -4%;
    width: clamp(220px, 24vw, 360px);
    height: clamp(220px, 24vw, 360px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.88;
    animation: prefooter-orbital-spin 20s linear infinite;
    transform-origin: center;
  }

  .about-prefooter__bubble {
    position: absolute;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(225, 245, 255, 0.78) 0%, rgba(225, 245, 255, 0) 74%);
    filter: blur(18px);
    mix-blend-mode: screen;
  }

  .about-prefooter__bubble--a {
    top: 16%;
    left: 50%;
    width: clamp(84px, 9vw, 130px);
    height: clamp(84px, 9vw, 130px);
    transform: translateX(-50%);
  }

  .about-prefooter__bubble--b {
    top: 50%;
    right: 10%;
    width: clamp(72px, 8vw, 112px);
    height: clamp(72px, 8vw, 112px);
    transform: translateY(-50%);
    opacity: 0.86;
  }

  .about-prefooter__bubble--c {
    bottom: 14%;
    left: 52%;
    width: clamp(66px, 7vw, 102px);
    height: clamp(66px, 7vw, 102px);
    transform: translateX(-50%);
    opacity: 0.8;
  }

  .about-prefooter__bubble--d {
    top: 50%;
    left: 10%;
    width: clamp(58px, 6vw, 90px);
    height: clamp(58px, 6vw, 90px);
    transform: translateY(-50%);
    opacity: 0.76;
  }

  .about-prefooter__grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.16;
    background-image:
      radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.22) 0, rgba(255, 255, 255, 0) 22%),
      radial-gradient(circle at 76% 18%, rgba(255, 255, 255, 0.14) 0, rgba(255, 255, 255, 0) 20%),
      radial-gradient(circle at 36% 68%, rgba(255, 255, 255, 0.12) 0, rgba(255, 255, 255, 0) 18%),
      radial-gradient(circle at 84% 80%, rgba(255, 255, 255, 0.16) 0, rgba(255, 255, 255, 0) 24%);
    mix-blend-mode: screen;
  }

  .about-prefooter__ambient-glow {
    position: absolute;
    border-radius: 999px;
    right: 9%;
    bottom: 12%;
    width: clamp(90px, 10vw, 150px);
    height: clamp(90px, 10vw, 150px);
    z-index: 0;
    pointer-events: none;
    filter: blur(22px);
    opacity: 0.42;
    background: radial-gradient(circle, rgba(232, 248, 255, 0.78) 0%, rgba(232, 248, 255, 0) 72%);
    animation: prefooter-glow-drift 12s ease-in-out infinite;
  }

  .about-prefooter__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 1300px;
    color: var(--prefooter-text);
  }

  .about-prefooter__title {
    margin: 0;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(3rem, 8vw, 118px);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.94;
    font-weight: 500;
  }

  .about-prefooter__title span {
    display: block;
    color: #ffffff;
  }

  .about-prefooter__outline-wrap {
    position: relative;
    display: inline-block;
  }

  .about-prefooter__outline-sizer {
    visibility: hidden;
    display: inline-block;
  }

  .about-prefooter__outline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .about-prefooter__outline-text {
    font-family: var(--font-heading--family), sans-serif;
    font-size: 150px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    fill: #ffffff;
  }

  .about-prefooter__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
  }

  .about-prefooter__btn {
    min-width: 220px;
    min-height: 48px;
    padding: 0.75rem 2.5rem;
    border-radius: 10px;
    border: 1px solid #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .about-prefooter__btn--solid {
    background: #ffffff;
    color: #0b6386;
    border-color: #ffffff;
  }

  .about-prefooter__btn--ghost {
    background: transparent;
    color: #ffffff;
  }

  .about-prefooter__btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .about-prefooter__btn--solid:hover {
    background: #f4f7f9;
    color: #0b6386;
  }

  .about-prefooter__btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 3px;
  }

  .about-prefooter__btn:active {
    transform: translateY(1px);
  }

  .about-prefooter [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: prefooter-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes prefooter-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes prefooter-orbital-spin {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes prefooter-glow-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(10px, -12px, 0) scale(1.06);
    }
  }

  @media (max-width: 989px) {
    .about-prefooter {
      min-height: 72vh;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .about-prefooter__orbital {
      top: -14%;
      right: -18%;
      width: clamp(170px, 35vw, 260px);
      height: clamp(170px, 35vw, 260px);
      opacity: 0.7;
    }

    .about-prefooter__title {
      font-size: clamp(3rem, 13vw, 4.75rem);
      line-height: 0.95;
    }

    .about-prefooter__title span {
      font-size: inherit;
    }

    .about-prefooter__outline-text {
      font-size: 140px;
    }

    .about-prefooter__btn {
      width: min(340px, 100%);
      min-width: 0;
    }
  }

  @media (min-width: 640px) {
    .about-prefooter__actions {
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-prefooter__orbital,
    .about-prefooter__ambient-glow,
    .about-prefooter [data-reveal] {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .about-prefooter__btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Prefooter",
  "tag": "section",
  "class": "about-prefooter-section",
  "settings": [
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#1A94BE"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#0F6D96"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#EAF4FA"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Embalajes"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "SIN LÍMITES"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Cotizar Mayorista"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Ver catálogo"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "About Prefooter"
    }
  ]
}
{% endschema %}

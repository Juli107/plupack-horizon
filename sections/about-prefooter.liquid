<section
  id="about-prefooter-{{ section.id }}"
  class="about-prefooter"
  style="
    --prefooter-bg-start: {{ section.settings.background_start }};
    --prefooter-bg-end: {{ section.settings.background_end }};
    --prefooter-text: {{ section.settings.text_color }};
  "
>
  <div class="about-prefooter__overlay" aria-hidden="true"></div>

  <div class="about-prefooter__inner">
    <h2 class="about-prefooter__title" data-reveal style="--reveal-delay: 0.06s;">
      <span>{{ section.settings.heading_line_1 }}</span>
      <span class="about-prefooter__outline">{{ section.settings.heading_line_2 }}</span>
    </h2>

    <div class="about-prefooter__actions" data-reveal style="--reveal-delay: 0.16s;">
      <a
        href="{{ section.settings.primary_cta_url | default: '/pages/cotizar' }}"
        class="about-prefooter__btn about-prefooter__btn--solid"
      >
        {{ section.settings.primary_cta_label }}
      </a>
      <a
        href="{{ section.settings.secondary_cta_url | default: '/collections/all' }}"
        class="about-prefooter__btn about-prefooter__btn--ghost"
      >
        {{ section.settings.secondary_cta_label }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-prefooter {
    position: relative;
    z-index: 20;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 90vh;
    padding: 5rem 1.5rem;
    background: linear-gradient(165deg, var(--prefooter-bg-start) 0%, var(--prefooter-bg-end) 100%);
    isolation: isolate;
  }

  .about-prefooter__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: rgba(30, 67, 119, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .about-prefooter__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 1300px;
    color: var(--prefooter-text);
  }

  .about-prefooter__title {
    margin: 0;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(3rem, 9vw, 116px);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    font-weight: 500;
  }

  .about-prefooter__title span {
    display: block;
    color: #ffffff;
  }

  .about-prefooter__outline {
    color: transparent;
    -webkit-text-stroke: 2.8px #ffffff;
    text-stroke: 2.8px #ffffff;
    paint-order: stroke fill;
  }

  .about-prefooter__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
  }

  .about-prefooter__btn {
    min-width: 220px;
    min-height: 48px;
    padding: 0.75rem 2.5rem;
    border-radius: 10px;
    border: 1px solid #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .about-prefooter__btn--solid {
    background: #ffffff;
    color: #0b6386;
    border-color: #ffffff;
  }

  .about-prefooter__btn--ghost {
    background: transparent;
    color: #ffffff;
  }

  .about-prefooter__btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .about-prefooter__btn--solid:hover {
    background: #f4f7f9;
    color: #0b6386;
  }

  .about-prefooter__btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 3px;
  }

  .about-prefooter__btn:active {
    transform: translateY(1px);
  }

  .about-prefooter [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: prefooter-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes prefooter-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-prefooter {
      min-height: 72vh;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .about-prefooter__title {
      font-size: clamp(3rem, 13vw, 4.75rem);
      line-height: 0.95;
    }

    .about-prefooter__title span {
      font-size: inherit;
    }

    .about-prefooter__outline {
      -webkit-text-stroke-width: 2px;
      text-stroke-width: 2px;
    }

    .about-prefooter__btn {
      width: min(340px, 100%);
      min-width: 0;
    }
  }

  @media (min-width: 640px) {
    .about-prefooter__actions {
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-prefooter [data-reveal] {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .about-prefooter__btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Prefooter",
  "tag": "section",
  "class": "about-prefooter-section",
  "settings": [
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#1E4377"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#143059"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#EAF4FA"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Embalajes"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "SIN LÍMITES"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Cotizar Mayorista"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Ver catálogo"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "About Prefooter"
    }
  ]
}
{% endschema %}

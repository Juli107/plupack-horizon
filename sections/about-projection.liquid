<section
  id="about-projection-{{ section.id }}"
  class="about-projection"
  style="
    --projection-bg: {{ section.settings.background_color }};
    --projection-text: {{ section.settings.text_color }};
  "
>
  <div class="about-projection__inner">
    <header class="about-projection__top" data-reveal style="--reveal-delay: 0.06s;">
      <h2 class="about-projection__title">{{ section.settings.heading }}</h2>
      {% liquid
        assign claim_html = section.settings.claim
        assign claim_html = claim_html | replace: 'estructural.', '<span class="about-projection__claim-outline">estructural.</span>'
        assign claim_html = claim_html | replace: 'estructural', '<span class="about-projection__claim-outline">estructural</span>'
      %}
      <p class="about-projection__claim">{{ claim_html }}</p>
    </header>

    <div class="about-projection__pillars" data-reveal style="--reveal-delay: 0.14s;" role="list">
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_1_title }}</h3>
        <p>{{ section.settings.pillar_1_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_2_title }}</h3>
        <p>{{ section.settings.pillar_2_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_3_title }}</h3>
        <p>{{ section.settings.pillar_3_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_4_title }}</h3>
        <p>{{ section.settings.pillar_4_text }}</p>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-projection {
    position: relative;
    background: var(--projection-bg);
    color: var(--projection-text);
    padding: clamp(4rem, 9vh, 6.2rem) clamp(1rem, 3vw, 2.8rem) clamp(4.2rem, 8vh, 6.4rem);
    overflow: clip;
    isolation: isolate;
  }

  .about-projection::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(140% 120% at 12% 10%, rgba(20, 108, 144, 0.07) 0%, rgba(20, 108, 144, 0) 56%),
      linear-gradient(180deg, rgba(20, 108, 144, 0.02) 0%, rgba(20, 108, 144, 0) 70%);
    z-index: 0;
  }

  .about-projection::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, rgba(20, 108, 144, 0.22) 0%, rgba(20, 108, 144, 0.06) 100%);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
  }

  .about-projection__inner {
    position: relative;
    z-index: 1;
    max-width: min(1320px, 100%);
    margin-inline: auto;
    display: grid;
    gap: clamp(3rem, 5vh, 4rem);
  }

  .about-projection__top {
    text-align: center;
    display: grid;
    gap: 1.6rem;
    justify-items: center;
    padding-bottom: clamp(2rem, 3vh, 2.8rem);
    border-bottom: 1px solid rgba(20, 108, 144, 0.24);
  }

  .about-projection__title {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.8rem, 2.8vw, 3.9rem);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    color: rgba(20, 108, 144, 0.95);
  }

  .about-projection__claim {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1.3rem, 2vw, 2.35rem);
    line-height: 1.2;
    font-weight: 430;
    color: rgba(20, 108, 144, 0.94);
    text-wrap: pretty;
  }

  .about-projection__claim-outline {
    color: transparent;
    -webkit-text-stroke: 1.2px rgba(20, 108, 144, 0.8);
    text-stroke: 1.2px rgba(20, 108, 144, 0.8);
    white-space: nowrap;
  }

  .about-projection__pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 1.2vw, 1.2rem);
  }

  .about-projection__pillar {
    margin: 0;
    padding: clamp(1.3rem, 1.9vw, 1.8rem) clamp(1.1rem, 2vw, 1.7rem);
    border-top: 1px solid rgba(20, 108, 144, 0.26);
    background: linear-gradient(180deg, rgba(20, 108, 144, 0.03) 0%, rgba(20, 108, 144, 0.01) 100%);
    min-height: clamp(170px, 12vw, 220px);
  }

  .about-projection__pillar:nth-child(1),
  .about-projection__pillar:nth-child(4) {
    transform: translateY(-10px);
  }

  .about-projection__pillar:nth-child(2),
  .about-projection__pillar:nth-child(3) {
    transform: translateY(10px);
  }

  .about-projection__pillar h3 {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.12rem, 1.4vw, 1.75rem);
    line-height: 1.16;
    letter-spacing: 0.004em;
    color: rgba(20, 108, 144, 0.95);
    font-weight: 560;
    text-wrap: balance;
  }

  .about-projection__pillar p {
    margin: 0.65rem 0 0;
    max-width: 34ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(0.95rem, 1.05vw, 1.16rem);
    line-height: 1.46;
    color: rgba(20, 108, 144, 0.86);
    text-wrap: pretty;
  }

  .about-projection [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: about-projection-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes about-projection-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-projection {
      padding-top: 2.4rem;
      padding-bottom: 2rem;
      padding-inline: 1rem;
    }

    .about-projection::after {
      display: none;
    }

    .about-projection__top {
      gap: 1rem;
      padding-bottom: 1.2rem;
    }

    .about-projection__title {
      font-size: clamp(1.3rem, 7vw, 2rem);
      line-height: 1.08;
    }

    .about-projection__claim {
      max-width: 100%;
      font-size: clamp(1.02rem, 4.8vw, 1.3rem);
      line-height: 1.35;
    }

    .about-projection__claim-outline {
      -webkit-text-stroke-width: 0.9px;
      text-stroke-width: 0.9px;
    }

    .about-projection__pillars {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .about-projection__pillar {
      min-height: 0;
      padding: 1rem 0.95rem 1.1rem;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-projection [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Projection",
  "tag": "section",
  "class": "about-projection-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#DDE6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#146C90"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Proyección y crecimiento"
    },
    {
      "type": "textarea",
      "id": "claim",
      "label": "Claim",
      "default": "Nuestra expansión no es solo territorial. Es estructural."
    },
    {
      "type": "text",
      "id": "pillar_1_title",
      "label": "Pilar 1 título",
      "default": "Expansión operativa"
    },
    {
      "type": "textarea",
      "id": "pillar_1_text",
      "label": "Pilar 1 descripción",
      "default": "Ampliamos presencia en todas las provincias para garantizar cobertura nacional sostenida y tiempos de entrega competitivos."
    },
    {
      "type": "text",
      "id": "pillar_2_title",
      "label": "Pilar 2 título",
      "default": "Infraestructura y logística"
    },
    {
      "type": "textarea",
      "id": "pillar_2_text",
      "label": "Pilar 2 descripción",
      "default": "Fortalecemos nuestra estructura logística para mejorar previsibilidad, trazabilidad y eficiencia en cada pedido."
    },
    {
      "type": "text",
      "id": "pillar_3_title",
      "label": "Pilar 3 título",
      "default": "Desarrollo de producto"
    },
    {
      "type": "textarea",
      "id": "pillar_3_text",
      "label": "Pilar 3 descripción",
      "default": "Incorporamos nuevas líneas según demanda real del mercado, ampliando el catálogo sin perder foco operativo."
    },
    {
      "type": "text",
      "id": "pillar_4_title",
      "label": "Pilar 4 título",
      "default": "Sustentabilidad aplicada"
    },
    {
      "type": "textarea",
      "id": "pillar_4_text",
      "label": "Pilar 4 descripción",
      "default": "Avanzamos hacia procesos más eficientes y materiales responsables, con impacto medible y criterios técnicos claros."
    }
  ],
  "presets": [
    {
      "name": "About Projection"
    }
  ]
}
{% endschema %}

<section
  id="about-projection-{{ section.id }}"
  class="about-projection"
  style="
    --projection-bg: {{ section.settings.background_color }};
    --projection-text: {{ section.settings.text_color }};
  "
>
  <div class="about-projection__inner" data-reveal style="--reveal-delay: 0.08s;">
    <h2 class="about-projection__title">{{ section.settings.heading }}</h2>
    <div class="about-projection__copy">
      <p>{{ section.settings.paragraph }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-projection {
    position: relative;
    background: var(--projection-bg);
    color: var(--projection-text);
    padding: clamp(2rem, 4vh, 3rem) clamp(0.6rem, 1.2vw, 1rem) clamp(2.4rem, 5vh, 3.4rem);
  }

  .about-projection::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("{{ 'noise.webp' | asset_url }}");
    background-repeat: repeat;
    opacity: 0.07;
    mix-blend-mode: soft-light;
  }

  .about-projection__inner {
    position: relative;
    z-index: 1;
    max-width: min(1680px, 100%);
    margin-inline: auto;
    border: 1px solid rgba(20, 108, 144, 0.18);
    display: grid;
    grid-template-columns: minmax(0, 0.52fr) minmax(0, 1fr);
    min-height: clamp(200px, 20vw, 290px);
  }

  .about-projection__title,
  .about-projection__copy {
    margin: 0;
    padding: clamp(1.3rem, 2.5vw, 2.3rem);
  }

  .about-projection__title {
    border-right: 1px solid rgba(20, 108, 144, 0.18);
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.5rem, 2.3vw, 3.1rem);
    line-height: 1.05;
    font-weight: 520;
    letter-spacing: 0.006em;
    text-transform: uppercase;
    color: rgba(20, 108, 144, 0.95);
  }

  .about-projection__copy {
    display: flex;
    align-items: flex-start;
  }

  .about-projection__copy p {
    margin: 0;
    max-width: 980px;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1rem, 1.35vw, 2rem);
    line-height: 1.34;
    font-weight: 430;
    color: rgba(20, 108, 144, 0.94);
    text-wrap: balance;
  }

  .about-projection [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: about-projection-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes about-projection-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-projection {
      padding-top: 1.2rem;
      padding-bottom: 2rem;
    }

    .about-projection__inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .about-projection__title {
      border-right: 0;
      border-bottom: 1px solid rgba(20, 108, 144, 0.18);
      font-size: clamp(1.3rem, 7vw, 2rem);
      line-height: 1.08;
    }

    .about-projection__copy p {
      font-size: clamp(0.98rem, 4.2vw, 1.16rem);
      line-height: 1.4;
      text-wrap: pretty;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-projection [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Projection",
  "tag": "section",
  "class": "about-projection-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#DDE6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#146C90"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Proyección y crecimiento"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Trabajamos para expandir nuestra presencia en todas las provincias, mejorar la estructura logística y convertirnos en la elección preferida de papeleras, empresas de catering, industrias y comercios. Al mismo tiempo, optimizamos procesos y desarrollamos nuevas líneas de productos para operar de forma más eficiente, con un enfoque ambiental responsable y medible."
    }
  ],
  "presets": [
    {
      "name": "About Projection"
    }
  ]
}
{% endschema %}

<section
  id="about-projection-{{ section.id }}"
  class="about-projection"
  style="
    --projection-bg: {{ section.settings.background_color }};
    --projection-text: {{ section.settings.text_color }};
  "
>
  <div class="about-projection__accent about-projection__accent--left" aria-hidden="true">
    <svg viewBox="0 0 560 560" class="about-projection__accent-svg" focusable="false">
      <circle cx="280" cy="280" r="280" class="about-projection__accent-ring" />
      <circle cx="280" cy="280" r="228" class="about-projection__accent-ring" />
      <circle cx="280" cy="280" r="176" class="about-projection__accent-ring-faint" />
    </svg>
  </div>

  <div class="about-projection__accent about-projection__accent--right" aria-hidden="true">
    <svg viewBox="0 0 560 560" class="about-projection__accent-svg" focusable="false">
      <circle cx="280" cy="280" r="280" class="about-projection__accent-ring" />
      <circle cx="280" cy="280" r="228" class="about-projection__accent-ring" />
      <circle cx="280" cy="280" r="176" class="about-projection__accent-ring-faint" />
    </svg>
  </div>

  <div class="about-projection__inner">
    <div class="about-projection__top" data-reveal style="--reveal-delay: 0.06s;">
      <h2 class="about-projection__title">{{ section.settings.heading }}</h2>
      <div class="about-projection__copy">
        <p>{{ section.settings.paragraph }}</p>
      </div>
    </div>

    <div class="about-projection__chart-wrap" data-reveal style="--reveal-delay: 0.14s;">
      <svg viewBox="0 0 1200 360" class="about-projection__chart" role="img" aria-label="Curva ascendente de proyeccion de crecimiento">
        <line x1="80" y1="290" x2="1120" y2="290" class="about-projection__axis" />
        <line x1="80" y1="70" x2="80" y2="290" class="about-projection__axis" />
        <path d="M 110 268 C 260 250, 340 230, 470 206 C 610 180, 690 146, 820 118 C 920 98, 995 80, 1088 64" class="about-projection__curve" pathLength="100" />
        <path d="M 110 268 C 260 250, 340 230, 470 206 C 610 180, 690 146, 820 118 C 920 98, 995 80, 1088 64 L 1088 290 L 110 290 Z" class="about-projection__area" />
        <circle cx="110" cy="268" r="7" class="about-projection__dot" />
        <circle cx="350" cy="226" r="7" class="about-projection__dot" />
        <circle cx="590" cy="186" r="7" class="about-projection__dot" />
        <circle cx="820" cy="118" r="7" class="about-projection__dot" />
        <circle cx="1088" cy="64" r="7" class="about-projection__dot" />
      </svg>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-projection {
    position: relative;
    background: var(--projection-bg);
    color: var(--projection-text);
    padding: clamp(3rem, 6vh, 4.8rem) clamp(1rem, 2.8vw, 2.4rem) clamp(3.2rem, 6vh, 5rem);
    overflow: clip;
  }

  .about-projection__accent {
    position: absolute;
    width: clamp(420px, 28vw, 560px);
    aspect-ratio: 1;
    pointer-events: none;
    opacity: 0.5;
    z-index: 0;
    clip-path: inset(0 0 50% 0);
  }

  .about-projection__accent--left {
    left: clamp(-310px, -14vw, -180px);
    top: clamp(130px, 16vw, 220px);
  }

  .about-projection__accent--right {
    right: clamp(-310px, -14vw, -180px);
    top: clamp(130px, 16vw, 220px);
    transform: scaleX(-1);
  }

  .about-projection__accent-svg {
    width: 100%;
    height: 100%;
  }

  .about-projection__accent-ring,
  .about-projection__accent-ring-faint {
    fill: none;
    stroke: rgba(20, 108, 144, 0.24);
    stroke-width: 1.1;
  }

  .about-projection__accent-ring-faint {
    stroke: rgba(20, 108, 144, 0.16);
  }

  .about-projection__inner {
    position: relative;
    z-index: 1;
    max-width: min(1500px, 100%);
    margin-inline: auto;
    display: grid;
    gap: clamp(1.8rem, 3vw, 2.6rem);
  }

  .about-projection__top {
    border: 1px solid rgba(20, 108, 144, 0.18);
    display: grid;
    grid-template-columns: minmax(0, 0.48fr) minmax(0, 1fr);
    align-items: start;
  }

  .about-projection__title {
    margin: 0;
    padding: clamp(1.5rem, 2.6vw, 2.5rem);
    border-right: 1px solid rgba(20, 108, 144, 0.18);
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.6rem, 2.5vw, 3.4rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: 0.006em;
    text-transform: uppercase;
    color: rgba(20, 108, 144, 0.95);
  }

  .about-projection__copy {
    padding: clamp(1.5rem, 2.6vw, 2.5rem);
    display: flex;
    align-items: flex-start;
  }

  .about-projection__copy p {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1.02rem, 1.18vw, 1.42rem);
    line-height: 1.4;
    font-weight: 430;
    color: rgba(20, 108, 144, 0.94);
    text-wrap: balance;
  }

  .about-projection__chart-wrap {
    border: 1px solid rgba(20, 108, 144, 0.18);
    background: linear-gradient(180deg, rgba(20, 108, 144, 0.03) 0%, rgba(20, 108, 144, 0.01) 100%);
    padding: clamp(0.8rem, 1.4vw, 1.2rem);
  }

  .about-projection__chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-projection__axis {
    stroke: rgba(20, 108, 144, 0.35);
    stroke-width: 1.2;
  }

  .about-projection__curve {
    fill: none;
    stroke: rgba(20, 108, 144, 0.82);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: about-projection-draw 1300ms ease-out forwards;
    animation-delay: 320ms;
  }

  .about-projection__area {
    fill: rgba(20, 108, 144, 0.08);
  }

  .about-projection__dot {
    fill: #146c90;
    stroke: rgba(221, 230, 237, 0.9);
    stroke-width: 2.2;
    transform-origin: center;
    animation: about-projection-dot-in 520ms ease-out forwards;
    opacity: 0;
  }

  .about-projection__dot:nth-of-type(1) {
    animation-delay: 700ms;
  }

  .about-projection__dot:nth-of-type(2) {
    animation-delay: 780ms;
  }

  .about-projection__dot:nth-of-type(3) {
    animation-delay: 860ms;
  }

  .about-projection__dot:nth-of-type(4) {
    animation-delay: 940ms;
  }

  .about-projection__dot:nth-of-type(5) {
    animation-delay: 1020ms;
  }

  .about-projection [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: about-projection-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes about-projection-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes about-projection-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes about-projection-dot-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 989px) {
    .about-projection {
      padding-top: 2rem;
      padding-bottom: 2rem;
      padding-inline: 1rem;
    }

    .about-projection__accent {
      display: none;
    }

    .about-projection__top {
      grid-template-columns: 1fr;
    }

    .about-projection__title {
      border-right: 0;
      border-bottom: 1px solid rgba(20, 108, 144, 0.18);
      font-size: clamp(1.3rem, 7vw, 2rem);
      line-height: 1.08;
    }

    .about-projection__copy {
      padding-top: 1.1rem;
    }

    .about-projection__copy p {
      font-size: clamp(0.98rem, 4.2vw, 1.16rem);
      line-height: 1.4;
      text-wrap: pretty;
    }

    .about-projection__curve {
      stroke-width: 2.4;
    }

    .about-projection__dot {
      r: 5.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-projection__curve,
    .about-projection__dot,
    .about-projection [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .about-projection__curve {
      stroke-dashoffset: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Projection",
  "tag": "section",
  "class": "about-projection-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#DDE6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#146C90"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Proyección y crecimiento"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Trabajamos para expandir nuestra presencia en todas las provincias, mejorar la estructura logística y convertirnos en la elección preferida de papeleras, empresas de catering, industrias y comercios. Al mismo tiempo, optimizamos procesos y desarrollamos nuevas líneas de productos para operar de forma más eficiente, con un enfoque ambiental responsable y medible."
    }
  ],
  "presets": [
    {
      "name": "About Projection"
    }
  ]
}
{% endschema %}

<section
  id="about-projection-{{ section.id }}"
  class="about-projection"
  style="
    --projection-bg: {{ section.settings.background_color }};
    --projection-text: {{ section.settings.text_color }};
  "
>
  <div class="about-projection__line about-projection__line--left" aria-hidden="true"></div>
  <div class="about-projection__line about-projection__line--right" aria-hidden="true"></div>

  <div class="about-projection__inner">
    <header class="about-projection__top" data-reveal style="--reveal-delay: 0.06s;">
      <h2 class="about-projection__title">{{ section.settings.heading }}</h2>
      <p class="about-projection__claim">{{ section.settings.claim }}</p>
    </header>

    <div class="about-projection__pillars" data-reveal style="--reveal-delay: 0.14s;" role="list">
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_1_title }}</h3>
        <p>{{ section.settings.pillar_1_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_2_title }}</h3>
        <p>{{ section.settings.pillar_2_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_3_title }}</h3>
        <p>{{ section.settings.pillar_3_text }}</p>
      </article>
      <article class="about-projection__pillar">
        <h3>{{ section.settings.pillar_4_title }}</h3>
        <p>{{ section.settings.pillar_4_text }}</p>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-projection {
    position: relative;
    overflow: clip;
    background: var(--projection-bg);
    color: var(--projection-text);
    padding: clamp(3.4rem, 7vh, 5rem) clamp(1rem, 3vw, 2.6rem) clamp(3.8rem, 8vh, 5.6rem);
  }

  .about-projection__line {
    position: absolute;
    width: clamp(360px, 26vw, 520px);
    aspect-ratio: 1;
    border: 1px solid rgba(20, 108, 144, 0.2);
    border-radius: 999px;
    clip-path: inset(0 0 50% 0);
    pointer-events: none;
    opacity: 0.45;
  }

  .about-projection__line--left {
    left: clamp(-290px, -14vw, -180px);
    top: clamp(120px, 14vw, 210px);
  }

  .about-projection__line--right {
    right: clamp(-290px, -14vw, -180px);
    top: clamp(120px, 14vw, 210px);
  }

  .about-projection__inner {
    position: relative;
    z-index: 1;
    max-width: min(1360px, 100%);
    margin-inline: auto;
    display: grid;
    gap: clamp(2.2rem, 4vh, 3rem);
  }

  .about-projection__top {
    display: grid;
    grid-template-columns: minmax(0, 0.45fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 3rem);
    padding-bottom: clamp(1.8rem, 2.8vh, 2.6rem);
    border-bottom: 1px solid rgba(20, 108, 144, 0.22);
  }

  .about-projection__title {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.7rem, 2.7vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(20, 108, 144, 0.96);
  }

  .about-projection__claim {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1.08rem, 1.45vw, 1.65rem);
    line-height: 1.34;
    font-weight: 430;
    color: rgba(20, 108, 144, 0.94);
    text-wrap: pretty;
  }

  .about-projection__pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid rgba(20, 108, 144, 0.22);
    border-left: 1px solid rgba(20, 108, 144, 0.22);
  }

  .about-projection__pillar {
    margin: 0;
    min-height: clamp(170px, 12vw, 220px);
    padding: clamp(1.2rem, 1.8vw, 1.8rem) clamp(1rem, 2vw, 1.5rem);
    border-right: 1px solid rgba(20, 108, 144, 0.22);
    border-bottom: 1px solid rgba(20, 108, 144, 0.22);
  }

  .about-projection__pillar h3 {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.1rem, 1.4vw, 1.7rem);
    line-height: 1.14;
    font-weight: 560;
    color: rgba(20, 108, 144, 0.96);
  }

  .about-projection__pillar p {
    margin: 0.62rem 0 0;
    max-width: 38ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(0.94rem, 1vw, 1.12rem);
    line-height: 1.44;
    color: rgba(20, 108, 144, 0.86);
    text-wrap: pretty;
  }

  .about-projection [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: about-projection-reveal 680ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes about-projection-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-projection {
      padding-top: 2.3rem;
      padding-bottom: 2rem;
      padding-inline: 1rem;
    }

    .about-projection__line {
      display: none;
    }

    .about-projection__top {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
      justify-items: center;
      padding-bottom: 1.2rem;
    }

    .about-projection__title {
      font-size: clamp(1.3rem, 7vw, 2rem);
      line-height: 1.08;
    }

    .about-projection__claim {
      max-width: 100%;
      font-size: clamp(1.02rem, 4.8vw, 1.3rem);
      line-height: 1.35;
    }

    .about-projection__pillars {
      grid-template-columns: 1fr;
    }

    .about-projection__pillar {
      min-height: 0;
      padding: 1rem 0.95rem 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-projection [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Projection",
  "tag": "section",
  "class": "about-projection-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#DDE6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#146C90"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Proyección y crecimiento"
    },
    {
      "type": "textarea",
      "id": "claim",
      "label": "Claim",
      "default": "Nuestra expansión no es solo territorial. Es estructural."

{%- comment -%}
  PLUPack · Barra superior del encabezado
  Franja de color sobre el menú principal con mensaje, buscador, WhatsApp y teléfono.
  Se edita desde Personalizar > Encabezado > Barra superior.
{%- endcomment -%}

{%- liquid
  assign plu_phone = section.settings.phone | default: shop.phone
  assign plu_phone_link = plu_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign plu_whatsapp = section.settings.whatsapp | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')' | remove: '.'
-%}

<div
  class="plu-topbar section section--page-width"
  style="--plu-topbar-bg: {{ section.settings.background }}; --plu-topbar-fg: {{ section.settings.text_color }};"
>
  <div class="plu-topbar__inner">
    {%- if section.settings.message != blank -%}
      <p class="plu-topbar__message">{{ section.settings.message | escape }}</p>
    {%- endif -%}

    <div class="plu-topbar__actions">
      {%- if section.settings.show_search -%}
        <form class="plu-topbar__search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="PluTopbarSearch-{{ section.id }}">
            {{- section.settings.search_placeholder | escape -}}
          </label>
          <svg class="plu-topbar__search-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="m13 13 4.25 4.25" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <input
            id="PluTopbarSearch-{{ section.id }}"
            class="plu-topbar__search-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            enterkeyhint="search"
          >
          <input type="hidden" name="options[prefix]" value="last">
        </form>
      {%- endif -%}

      {%- if plu_whatsapp != blank -%}
        <a
          class="plu-topbar__link"
          href="https://wa.me/{{ plu_whatsapp }}"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M10 2.2a7.7 7.7 0 0 0-6.6 11.7L2.3 17.7l3.9-1a7.7 7.7 0 1 0 3.8-14.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M7.3 6.4c.2-.4.5-.4.7-.4h.5c.2 0 .4.1.5.4l.6 1.4c.1.2 0 .5-.1.6l-.5.6c.4.9 1.2 1.7 2.2 2.2l.6-.5c.2-.2.4-.2.6-.1l1.4.6c.3.1.4.3.4.5v.5c0 .3-.1.5-.4.7-.5.3-1.4.6-2.6.1-1.6-.6-3-2-3.6-3.6-.5-1.2-.2-2.1.1-2.6Z" fill="currentColor"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      {%- endif -%}

      {%- if plu_phone != blank -%}
        <a class="plu-topbar__phone" href="tel:{{ plu_phone_link }}">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M4.4 2.8h2.7l1.4 3.4-1.7 1.1a9.2 9.2 0 0 0 4.9 4.9l1.1-1.7 3.4 1.4v2.7a1.7 1.7 0 0 1-1.7 1.7A12.9 12.9 0 0 1 2.7 4.5a1.7 1.7 0 0 1 1.7-1.7Z" fill="currentColor"/>
          </svg>
          <span>{{ plu_phone | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.logo_brand_color -%}
  <style>
    #header-component .header-logo__image {
      filter: brightness(0) saturate(100%) invert(20%) sepia(30%) saturate(4378%) hue-rotate(188deg) brightness(96%) contrast(94%);
    }
  </style>
{%- endif -%}

{% stylesheet %}
  .plu-topbar {
    background: var(--plu-topbar-bg, #084e85);
    color: var(--plu-topbar-fg, #ffffff);
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .plu-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding-block: 6px;
  }

  .plu-topbar__message {
    margin: 0;
    opacity: 0.9;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .plu-topbar__actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-left: auto;
  }

  .plu-topbar__search {
    position: relative;
    display: flex;
    align-items: center;
    width: 320px;
    margin: 0;
  }

  .plu-topbar__search-icon {
    position: absolute;
    left: 12px;
    width: 17px;
    height: 17px;
    color: #6b7686;
    pointer-events: none;
  }

  .plu-topbar__search-input {
    width: 100%;
    height: 36px;
    padding: 0 12px 0 38px;
    border: 0;
    border-radius: 8px;
    background: #ffffff;
    color: #1b2433;
    font: inherit;
    font-size: 0.9375rem;
    -webkit-appearance: none;
    appearance: none;
  }

  .plu-topbar__search-input::placeholder {
    color: #7b8594;
  }

  .plu-topbar__search-input:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.55);
    outline-offset: 2px;
  }

  .plu-topbar__link,
  .plu-topbar__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .plu-topbar__link svg,
  .plu-topbar__phone svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .plu-topbar__phone {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .plu-topbar__link:hover,
  .plu-topbar__phone:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .plu-topbar__search {
      width: 240px;
    }
  }

  @media screen and (max-width: 749px) {
    .plu-topbar__inner {
      justify-content: center;
      min-height: 40px;
      padding-block: 0;
    }

    .plu-topbar__message,
    .plu-topbar__search {
      display: none;
    }

    .plu-topbar__actions {
      margin-left: 0;
      gap: 18px;
    }

    .plu-topbar__phone {
      font-size: 0.9375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra superior",
  "tag": "section",
  "class": "plu-topbar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Mensaje (opcional)",
      "default": "Distribuidor mayorista de embalajes e insumos",
      "info": "Se oculta en celulares."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar buscador",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Texto del buscador",
      "default": "Buscador de productos…"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono",
      "default": "+54 11 3389 4270",
      "info": "Si queda vacío, se usa el teléfono cargado en la tienda."
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp (opcional)",
      "info": "Número con código de país y sin espacios, por ejemplo 5491133894270."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Color de fondo",
      "default": "#084e85"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "logo_brand_color",
      "label": "Mostrar el logo en azul",
      "default": true,
      "info": "Activar si el logo cargado es blanco. Desactivar si se sube un logo a color."
    }
  ],
  "presets": [
    {
      "name": "Barra superior"
    }
  ]
}
{% endschema %}

{% liquid
  assign collection_list = section.settings.collection_list
  assign visible_count = section.settings.visible_count

  if collection_list == blank
    assign limit = visible_count | plus: 4
    for i in (1..limit)
      assign collection_list = collection_list | append: ', '
    endfor
    assign collection_list = collection_list | split: ','
  endif

  assign active_collection = collection_list | find: 'id', collection.id | default: collection_list.first
  assign total_collections = collection_list.size
  assign show_more_button = false
  
  if total_collections > visible_count
    assign show_more_button = true
  endif
%}

{%- style -%}
  /* Base Layout */
  .section-collection-links {
    position: relative;
    z-index: 20;
    overflow: visible !important; /* Prevent clipping */
  }

  .collection-links__wrapper {
    position: relative;
    max-width: 100%;
  }

  /* Top Bar */
  .collection-links__top-bar {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 24px;
    align-items: center;
    border-bottom: 1px solid #2773a8;
    padding-bottom: 12px;
    scrollbar-width: none; /* Hide scrollbar Firefox */
  }
  
  .collection-links__top-bar::-webkit-scrollbar {
    display: none; /* Hide scrollbar Chrome/Safari */
  }

  /* Ensure items in top bar don't shrink/wrap weirdly */
  .collection-links__top-bar .collection-links__link-wrapper {
    flex-shrink: 0;
  }

  /* Links Styling (Migrated) */
  .collection-links__link {
    white-space: nowrap;
    padding: 8px 0;
    font-size: 14px;
    color: #666;
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }

  .collection-links__link:hover {
    color: #333;
  }

  .collection-links__link[aria-current="true"] {
    color: #2773a8;
    font-weight: 600;
  }

  /* Hide parts as requested */
  .collection-links__count,
  .collection-links__image {
    display: none !important;
  }

  /* View More Button */
  .collection-links__toggle {
    background: transparent;
    border: none;
    color: #2773A8;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 0;
    text-decoration: underline;
    white-space: nowrap;
    margin-left: auto;
    flex-shrink: 0;
  }
  
  .collection-links__toggle:hover {
    opacity: 0.8;
  }

  /* Dropdown Panel */
  .collection-links__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-top: none;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    padding: 24px;
    z-index: 100;
    margin-top: -1px;
    display: block;
    box-sizing: border-box;
  }

  .collection-links__dropdown[hidden] {
    display: none;
  }

  /* Grid Layout */
  .collection-links__dropdown-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr); /* Mobile default */
    gap: 16px;
  }

  @media (min-width: 480px) {
    .collection-links__dropdown-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .collection-links__dropdown-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collection-links__dropdown-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section-collection-links section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="collection-links-{{ section.id }}"
>
  <div class="collection-links__wrapper">
    <!-- Top Bar -->
    <div class="collection-links__top-bar" role="list" data-top-bar>
       {% for collection in collection_list limit: visible_count %}
        {% liquid
          assign current = false
          if collection.id == active_collection.id
            assign current = true
          endif
        %}
        <div class="collection-links__link-wrapper" role="listitem">
            {% content_for 'block',
              type: '_collection-link',
              id: 'link',
              closest.collection: collection,
              index: forloop.index0,
              current: current
            %}
        </div>
       {% endfor %}

       {% if show_more_button %}
        <button 
            type="button"
            class="collection-links__toggle" 
            id="CollectionLinksToggle-{{ section.id }}"
            aria-expanded="false" 
            aria-controls="CollectionLinksDropdown-{{ section.id }}"
            data-collection-links-toggle
        >
            <span class="collection-links__toggle-text">Ver más</span>
        </button>
       {% endif %}
    </div>

    <!-- Mega Dropdown -->
    {% if show_more_button %}
      <div 
        id="CollectionLinksDropdown-{{ section.id }}" 
        class="collection-links__dropdown" 
        hidden
      >
        <div class="collection-links__dropdown-grid" role="list">
           {% for collection in collection_list offset: visible_count %}
            {% liquid
              assign current = false
              if collection.id == active_collection.id
                assign current = true
              endif
            %}
            <div class="collection-links__link-wrapper" role="listitem">
                {% content_for 'block',
                  type: '_collection-link',
                  id: 'link',
                  closest.collection: collection,
                  index: forloop.index0,
                  current: current
                %}
            </div>
           {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('CollectionLinksToggle-{{ section.id }}');
    const dropdown = document.getElementById('CollectionLinksDropdown-{{ section.id }}');
    const toggleText = toggleBtn ? toggleBtn.querySelector('.collection-links__toggle-text') : null;

    if (!toggleBtn || !dropdown) return;

    function openDropdown() {
      dropdown.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      if (toggleText) toggleText.textContent = 'Ver menos';
    }

    function closeDropdown() {
      dropdown.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
      if (toggleText) toggleText.textContent = 'Ver más';
    }

    // Toggle Click
    toggleBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close on ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeDropdown();
        toggleBtn.focus(); // Return focus to toggle
      }
    });

    // Close on Outside Click
    document.addEventListener('click', function(e) {
      if (toggleBtn.getAttribute('aria-expanded') === 'true') {
        if (!dropdown.contains(e.target) && !toggleBtn.contains(e.target)) {
            closeDropdown();
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "t:names.collection_links",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
       "type": "range",
       "id": "visible_count",
       "label": "Top bar items count",
       "min": 3,
       "max": 12,
       "step": 1,
       "default": 6
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list"
    },
    {
        "type": "header",
        "content": "t:content.layout"
    },
    {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          },
          {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_links_spotlight",
      "category": "t:categories.collections",
      "blocks": {
        "link": {
          "type": "_collection-link",
          "static": true,
          "blocks": {
            "title": {
              "type": "_inline-collection-title",
              "name": "t:names.title",
              "static": true,
              "settings": {
                "font": "var(--font-subheading--family)"
              }
            }
          }
        }
      }
    }
  ]
}
{% endschema %}

<section
  id="about-hero-{{ section.id }}"
  class="about-hero"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
  "
>
  <div class="about-hero__inner">
    <div class="about-hero__intro">
      <p class="about-hero__eyebrow" data-reveal data-delay="0.05">{{ section.settings.eyebrow }}</p>

      <h1 class="about-hero__heading" data-reveal data-delay="0.12">
        <span>{{ section.settings.heading_line_1 }}</span>
        <span>{{ section.settings.heading_line_2 }}</span>
        <span>{{ section.settings.heading_line_3 }}</span>
      </h1>

      <div class="about-hero__copy" data-reveal data-delay="0.2">
        <p>{{ section.settings.paragraph_1 }}</p>
        <p>{{ section.settings.paragraph_2 }}</p>
      </div>
    </div>
  </div>

  <div class="about-hero__values" data-reveal data-delay="0.3">
    <span>{{ section.settings.value_1 }}</span>
    <span>{{ section.settings.value_2 }}</span>
    <span>{{ section.settings.value_3 }}</span>
  </div>
</section>

{% javascript %}
  (() => {
    const sectionId = 'about-hero-{{ section.id }}';
    const section = document.getElementById(sectionId);

    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const revealItems = section.querySelectorAll('[data-reveal]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const delay = entry.target.dataset.delay || '0';
          entry.target.style.transitionDelay = `${delay}s`;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -8% 0px',
      },
    );

    revealItems.forEach((item) => observer.observe(item));
  })();
{% endjavascript %}

{% stylesheet %}
  .about-hero {
    position: relative;
    background: var(--about-bg);
    color: var(--about-text);
    overflow: clip;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("{{ 'noise.webp' | asset_url }}");
    background-repeat: repeat;
    opacity: 0.1;
    mix-blend-mode: soft-light;
  }

  .about-hero__inner {
    position: relative;
    z-index: 1;
    max-width: min(1400px, 100%);
    margin: 0 auto;
    padding: clamp(7.5rem, 14vh, 12rem) clamp(1.5rem, 4vw, 4rem) clamp(5rem, 12vh, 9rem);
  }

  .about-hero__intro {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .about-hero__eyebrow {
    margin: 0 0 clamp(1.5rem, 2.2vw, 2.5rem);
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(0.72rem, 0.8vw, 0.95rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
  }

  .about-hero__heading {
    margin: 0;
    display: grid;
    gap: clamp(0.25rem, 0.6vw, 0.65rem);
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.92;
  }

  .about-hero__heading span {
    display: block;
    font-size: clamp(2.7rem, 9.1vw, 9.2rem);
  }

  .about-hero__copy {
    max-width: min(900px, 90%);
    margin: clamp(3rem, 5vw, 5.2rem) auto 0;
    display: grid;
    gap: 1.2rem;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1.06rem, 1.55vw, 2rem);
    line-height: 1.45;
    font-weight: 430;
  }

  .about-hero__copy p {
    margin: 0;
  }

  .about-hero__values {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(20, 108, 144, 0.35);
    border-bottom: 1px solid rgba(20, 108, 144, 0.35);
    min-height: clamp(4.6rem, 6.7vw, 6.3rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 1rem;
    padding: 0 clamp(1rem, 2.2vw, 2rem);
  }

  .about-hero__values span {
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(0.72rem, 1vw, 1.08rem);
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
  }

  .about-hero [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    transition-property: opacity, transform;
    transition-duration: 700ms;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .about-hero [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (max-width: 989px) {
    .about-hero__inner {
      padding-top: clamp(6.4rem, 12vh, 8.4rem);
      padding-bottom: clamp(4rem, 8.5vh, 5.2rem);
    }

    .about-hero__heading {
      line-height: 0.95;
    }

    .about-hero__copy {
      max-width: min(760px, 96%);
      font-size: clamp(1rem, 2.2vw, 1.35rem);
      line-height: 1.42;
    }

    .about-hero__values {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
    }

    .about-hero__values span {
      width: 100%;
      min-height: 3.9rem;
      display: grid;
      place-items: center;
      border-bottom: 1px solid rgba(20, 108, 144, 0.3);
      letter-spacing: 0.24em;
    }

    .about-hero__values span:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}


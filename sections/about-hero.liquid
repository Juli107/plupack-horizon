<section
  id="about-hero-{{ section.id }}"
  class="about-hero"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
  "
>
  <div class="about-hero__orbit about-hero__orbit--left" aria-hidden="true">
    <svg viewBox="0 0 600 600" class="about-hero__orbit-svg" focusable="false">
      <circle cx="300" cy="300" r="300" class="about-hero__orbit-stroke" />
      <circle cx="300" cy="300" r="252" class="about-hero__orbit-stroke" />
      <g class="about-hero__orbit-rotor">
        <circle cx="300" cy="300" r="130" class="about-hero__orbit-inner" />
        <circle cx="300" cy="300" r="88" class="about-hero__orbit-inner-faint" />
        <line x1="300" y1="300" x2="300" y2="212" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="300" y2="388" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="212" y2="300" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="388" y2="300" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="238" y2="238" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="362" y2="362" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="238" y2="362" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="362" y2="238" class="about-hero__orbit-line" />
      </g>
    </svg>
  </div>

  <div class="about-hero__orbit about-hero__orbit--right" aria-hidden="true">
    <svg viewBox="0 0 600 600" class="about-hero__orbit-svg" focusable="false">
      <circle cx="300" cy="300" r="300" class="about-hero__orbit-stroke" />
      <circle cx="300" cy="300" r="252" class="about-hero__orbit-stroke" />
      <g class="about-hero__orbit-rotor about-hero__orbit-rotor--reverse">
        <circle cx="300" cy="300" r="130" class="about-hero__orbit-inner" />
        <circle cx="300" cy="300" r="88" class="about-hero__orbit-inner-faint" />
        <line x1="300" y1="300" x2="300" y2="212" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="300" y2="388" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="212" y2="300" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="388" y2="300" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="238" y2="238" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="362" y2="362" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="238" y2="362" class="about-hero__orbit-line" />
        <line x1="300" y1="300" x2="362" y2="238" class="about-hero__orbit-line" />
      </g>
    </svg>
  </div>

  <div class="about-hero__inner">
    <div class="about-hero__intro">
      <p class="about-hero__eyebrow" data-reveal style="--reveal-delay: 0.05s;">{{ section.settings.eyebrow }}</p>

      <h1 class="about-hero__heading" data-reveal style="--reveal-delay: 0.12s;">
        <span>{{ section.settings.heading_line_1 }}</span>
        <span>{{ section.settings.heading_line_2 }}</span>
        <span>{{ section.settings.heading_line_3 }}</span>
      </h1>

      <div class="about-hero__copy" data-reveal style="--reveal-delay: 0.22s;">
        <p>{{ section.settings.paragraph_1 }}</p>
        <p>{{ section.settings.paragraph_2 }}</p>
      </div>
    </div>
  </div>

  <div class="about-hero__values" data-reveal style="--reveal-delay: 0.34s;">
    <span>{{ section.settings.value_1 }}</span>
    <span>{{ section.settings.value_2 }}</span>
    <span>{{ section.settings.value_3 }}</span>
  </div>
</section>

{% stylesheet %}
  .about-hero {
    position: relative;
    background: var(--about-bg);
    color: var(--about-text);
    overflow: clip;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("{{ 'noise.webp' | asset_url }}");
    background-repeat: repeat;
    opacity: 0.1;
    mix-blend-mode: soft-light;
  }

  .about-hero__inner {
    position: relative;
    z-index: 1;
    max-width: min(1400px, 100%);
    margin: 0 auto;
    padding: clamp(6.4rem, 11vh, 9rem) clamp(1.5rem, 4vw, 4rem) clamp(4.5rem, 9vh, 7rem);
  }

  .about-hero__orbit {
    display: none;
    position: absolute;
    width: clamp(600px, 42vw, 860px);
    aspect-ratio: 1;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
    clip-path: inset(0 0 50% 0);
  }

  .about-hero__orbit--left {
    left: clamp(-430px, -23vw, -300px);
    bottom: clamp(-250px, -13vw, -145px);
  }

  .about-hero__orbit--right {
    right: clamp(-430px, -23vw, -300px);
    bottom: clamp(-250px, -13vw, -145px);
  }

  .about-hero__orbit-svg {
    width: 100%;
    height: 100%;
  }

  .about-hero__orbit-stroke,
  .about-hero__orbit-inner,
  .about-hero__orbit-inner-faint,
  .about-hero__orbit-line {
    fill: none;
    stroke: rgba(20, 108, 144, 0.56);
    stroke-width: 1.1;
  }

  .about-hero__orbit-inner {
    stroke: rgba(20, 108, 144, 0.4);
  }

  .about-hero__orbit-inner-faint {
    stroke: rgba(20, 108, 144, 0.26);
  }

  .about-hero__orbit-line {
    stroke-linecap: round;
    stroke: rgba(20, 108, 144, 0.62);
    stroke-width: 1.25;
  }

  .about-hero__orbit-rotor {
    transform-origin: 300px 300px;
    animation: about-hero-orbit-spin 20s linear infinite;
  }

  .about-hero__orbit-rotor--reverse {
    animation-direction: reverse;
    animation-duration: 24s;
  }

  @keyframes about-hero-orbit-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  .about-hero__intro {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .about-hero__eyebrow {
    margin: 0 0 clamp(1.5rem, 2.2vw, 2.5rem);
    font-family: var(--font-accent--family), 'Roboto Mono', monospace;
    font-size: clamp(0.72rem, 0.8vw, 0.95rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
  }

  .about-hero__heading {
    margin: 0;
    display: grid;
    gap: clamp(0.25rem, 0.6vw, 0.65rem);
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.92;
  }

  .about-hero__heading span {
    display: block;
    font-size: clamp(2.5rem, 7.2vw, 7rem);
  }

  .about-hero__copy {
    max-width: min(900px, 90%);
    margin: clamp(3rem, 5vw, 5.2rem) auto 0;
    display: grid;
    gap: 1.2rem;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.45rem);
    line-height: 1.45;
    font-weight: 430;
  }

  .about-hero__copy p {
    margin: 0;
    max-width: 500px;
    margin-inline: auto;
  }

  .about-hero__values {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(20, 108, 144, 0.22);
    border-bottom: 1px solid rgba(20, 108, 144, 0.22);
    min-height: clamp(4.6rem, 6.7vw, 6.3rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 1rem;
    padding: 0 clamp(1rem, 2.2vw, 2rem);
  }

  .about-hero__values span {
    font-family: var(--font-accent--family), 'Roboto Mono', monospace;
    font-size: clamp(0.78rem, 0.96vw, 1.04rem);
    text-transform: uppercase;
    letter-spacing: 0.29em;
    font-weight: 600;
    color: rgba(20, 108, 144, 0.92);
    text-align: center;
    line-height: 1.2;
  }

  .about-hero [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    animation: about-hero-reveal 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
    will-change: opacity, transform;
  }

  @keyframes about-hero-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-hero__inner {
      padding-top: clamp(6.4rem, 12vh, 8.4rem);
      padding-bottom: clamp(4rem, 8.5vh, 5.2rem);
    }

    .about-hero__heading {
      line-height: 0.95;
    }

    .about-hero__copy {
      max-width: min(760px, 96%);
      font-size: clamp(1rem, 2.2vw, 1.35rem);
      line-height: 1.42;
    }

    .about-hero__values {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
    }

    .about-hero__values span {
      width: 100%;
      min-height: 3.9rem;
      display: grid;
      place-items: center;
      border-bottom: 1px solid rgba(20, 108, 144, 0.2);
      letter-spacing: 0.22em;
      font-size: clamp(0.78rem, 3.7vw, 0.92rem);
    }

    .about-hero__values span:last-child {
      border-bottom: 0;
    }
  }

  @media (min-width: 990px) {
    .about-hero__orbit {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero__orbit-rotor,
    .about-hero__orbit-rotor--reverse,
    .about-hero [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "about-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#DDE6ED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#146C90"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sobre nosotros"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Soluciones"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "integrales en"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3",
      "default": "embalaje"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Somos una empresa argentina que fabrica y distribuye insumos de embalaje para industria, gastronomía y salud. Operamos con lógica de abastecimiento, no de catálogo: centralizamos productos, coordinamos entregas y sostenemos el suministro para que tu operación no se frene."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Trabajamos con estándares claros de calidad, cumplimiento y atención directa. Si hay un problema, se resuelve. Si hay una necesidad recurrente, se anticipa."
    },
    {
      "type": "text",
      "id": "value_1",
      "label": "Bottom value 1",
      "default": "calidad garantizada"
    },
    {
      "type": "text",
      "id": "value_2",
      "label": "Bottom value 2",
      "default": "entrega eficiente"
    },
    {
      "type": "text",
      "id": "value_3",
      "label": "Bottom value 3",
      "default": "asesoría cercana"
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}

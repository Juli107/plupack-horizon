<section
  id="about-future-{{ section.id }}"
  class="about-future"
  style="
    --future-bg: {{ settings.about_page_purpose_bg }};
    --future-text: {{ settings.about_page_purpose_text }};
    --future-text-muted: {{ settings.about_page_purpose_text_muted }};
    --future-line: color-mix(in srgb, {{ settings.about_page_purpose_text }} 14%, transparent);
    --future-card-bg: color-mix(in srgb, white 78%, {{ settings.about_page_purpose_bg }} 22%);
    --future-card-border: color-mix(in srgb, {{ settings.about_page_purpose_text }} 12%, transparent);
  "
>
  <div class="about-future__inner">
    <div class="about-future__layout">
      <aside class="about-future__rail" data-reveal style="--reveal-delay: 0.1s;">
        <h2 class="about-future__title">{{ section.settings.heading }}</h2>
        <p class="about-future__rail-copy">
          Desde cobertura nacional y eficiencia operativa hasta desarrollo de producto y acuerdos sostenidos, el
          crecimiento se ejecuta con foco en continuidad y resultados medibles.
        </p>
      </aside>

      <ol class="about-future__axes" role="list">
        <li class="about-future__axis" data-reveal style="--reveal-delay: 0.16s;">
          <span class="about-future__index">01</span>
          <div class="about-future__axis-body">
            <h3>{{ section.settings.axis_1_title }}</h3>
            <p>{{ section.settings.axis_1_text }}</p>
          </div>
        </li>

        <li class="about-future__axis" data-reveal style="--reveal-delay: 0.22s;">
          <span class="about-future__index">02</span>
          <div class="about-future__axis-body">
            <h3>{{ section.settings.axis_2_title }}</h3>
            <p>{{ section.settings.axis_2_text }}</p>
          </div>
        </li>

        <li class="about-future__axis" data-reveal style="--reveal-delay: 0.28s;">
          <span class="about-future__index">03</span>
          <div class="about-future__axis-body">
            <h3>{{ section.settings.axis_3_title }}</h3>
            <p>{{ section.settings.axis_3_text }}</p>
          </div>
        </li>

        <li class="about-future__axis" data-reveal style="--reveal-delay: 0.34s;">
          <span class="about-future__index">04</span>
          <div class="about-future__axis-body">
            <h3>{{ section.settings.axis_4_title }}</h3>
            <p>{{ section.settings.axis_4_text }}</p>
          </div>
        </li>

        <li class="about-future__axis" data-reveal style="--reveal-delay: 0.4s;">
          <span class="about-future__index">05</span>
          <div class="about-future__axis-body">
            <h3>{{ section.settings.axis_5_title }}</h3>
            <p>{{ section.settings.axis_5_text }}</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionId = 'about-future-{{ section.id }}';

    const initFutureReveal = () => {
      const section = document.getElementById(sectionId);
      if (!section || section.dataset.revealInitialized === 'true') return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        section.dataset.revealReady = 'true';
        return;
      }

      section.dataset.revealInitialized = 'true';

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            section.dataset.revealReady = 'true';
            observer.disconnect();
          });
        },
        {
          threshold: 0.15,
          rootMargin: '0px 0px -10% 0px',
        }
      );

      observer.observe(section);

      section.addEventListener(
        'shopify:section:unload',
        () => {
          observer.disconnect();
        },
        { once: true }
      );
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFutureReveal, { once: true });
    } else {
      initFutureReveal();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target && event.target.id === sectionId) {
        initFutureReveal();
      }
    });
  })();
</script>

{% stylesheet %}
  .about-future {
    position: relative;
    overflow: clip;
    padding: 0 clamp(1rem, 2vw, 1.5rem) clamp(4.8rem, 10vh, 8.2rem);
    background: var(--future-bg);
    color: var(--future-text);
    isolation: isolate;
  }

  .about-future__inner {
    position: relative;
    z-index: 1;
    max-width: min(1550px, 100%);
    margin-inline: auto;
    padding-inline: clamp(0.4rem, 1.4vw, 1.5rem);
    display: grid;
    gap: 0;
  }

  .about-future__layout {
    display: grid;
    grid-template-columns: minmax(250px, 0.34fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: start;
  }

  .about-future__rail {
    position: static;
    display: grid;
    gap: 1.35rem;
  }

  .about-future__title {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    text-transform: uppercase;
    font-size: clamp(2.9rem, 7.4vw, 8.4rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--future-text);
  }

  .about-future__rail-copy {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(1.1rem, 1.3vw, 1.4rem);
    line-height: 1.42;
    color: var(--future-text-muted);
  }

  .about-future__axes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    max-width: min(40rem, 100%);
    width: 100%;
    justify-self: end;
  }

  .about-future__axis {
    display: grid;
    grid-template-columns: minmax(48px, 70px) minmax(0, 1fr);
    gap: clamp(0.95rem, 1.8vw, 1.6rem);
    align-items: start;
    min-height: 0;
    padding: clamp(1.35rem, 2.1vw, 1.9rem);
    background: var(--future-card-bg);
    border: 1px solid var(--future-card-border);
    border-radius: 18px;
    box-shadow: 0 14px 35px color-mix(in srgb, var(--future-text) 5%, transparent);
  }

  .about-future__index {
    margin-top: 0.18rem;
    font-family: var(--font-accent--family), 'Roboto Mono', monospace;
    font-size: clamp(0.76rem, 0.9vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--future-text) 62%, transparent);
  }

  .about-future__axis-body h3 {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(1.16rem, 1.5vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: 0.004em;
    color: var(--future-text);
    font-weight: 500;
  }

  .about-future__axis-body p {
    margin: 0.55rem 0 0;
    max-width: 66ch;
    font-family: var(--font-body--family), sans-serif;
    font-size: clamp(0.95rem, 1.05vw, 1.18rem);
    line-height: 1.48;
    color: var(--future-text-muted);
    font-weight: 410;
    text-wrap: pretty;
  }

  .about-future[data-reveal-ready='true'] [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    animation: about-future-reveal 720ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes about-future-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 989px) {
    .about-future {
      padding-bottom: clamp(3.6rem, 8vh, 4.8rem);
      padding-left: 0;
      padding-right: 0;
    }

    .about-future__layout {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .about-future__axes {
      max-width: 100%;
      width: 100%;
      justify-self: stretch;
    }

    .about-future__rail {
      position: static;
      gap: 0.85rem;
    }

    .about-future__title {
      font-size: clamp(2.2rem, 13vw, 3.8rem);
      line-height: 0.95;
    }

    .about-future__rail-copy {
      max-width: 100%;
      font-size: clamp(0.95rem, 4vw, 1.05rem);
    }

    .about-future__axis {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      min-height: 0;
      padding: 1rem 1rem 1.1rem;
      border-radius: 16px;
    }

    .about-future__index {
      margin-top: 0;
      font-size: 0.74rem;
      letter-spacing: 0.14em;
    }

    .about-future__axis-body h3 {
      font-size: clamp(1.06rem, 5.2vw, 1.3rem);
      line-height: 1.2;
    }

    .about-future__axis-body p {
      font-size: clamp(0.93rem, 3.9vw, 1.03rem);
      line-height: 1.45;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-future [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}


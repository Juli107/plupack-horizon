{% comment %}
  Custom Footer Section
  Matches the React footer design exactly
  Gradient background from #1E4377 to #143059
{% endcomment %}

<footer
  class="footer-custom{% if template.name != 'index' and template.suffix != 'nosotros' %} footer-custom--with-noise{% endif %}"
  style="--footer-noise-texture: url('{{ 'noise.webp' | asset_url }}');"
>
  {%- liquid
    # Use inverse logo if available, fallback to regular logo
    if settings.logo_inverse != blank
      assign logo = settings.logo_inverse
    elsif settings.logo != blank
      assign logo = settings.logo
    endif
  -%}

  {%- comment -%} Logo Section - Full Width {%- endcomment -%}
  <div class="footer-custom__logo-section">
    <div class="footer-custom__logo-container">
      {%- if logo != blank -%}
        <img
          src="{{ logo | image_url: width: 600 }}"
          alt="{{ shop.name }}"
          class="footer-custom__logo"
          width="{{ logo.width }}"
          height="{{ logo.height }}"
          loading="lazy"
        >
      {%- else -%}
        <span class="footer-custom__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Info Columns - 3 Column Grid {%- endcomment -%}
  <div class="footer-custom__columns">
    {%- comment -%} Column 1: Dónde estamos {%- endcomment -%}
    <div class="footer-custom__column">
      <h3 class="footer-custom__column-title">{{ section.settings.col1_title }}</h3>
      <p class="footer-custom__address">
        {{ section.settings.address | newline_to_br }}
      </p>
      <a
        href="{{ section.settings.maps_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-custom__maps-link"
      >
        {{ section.settings.maps_link_text }}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="footer-custom__arrow-icon"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>

    {%- comment -%} Column 2: Navegación {%- endcomment -%}
    <div class="footer-custom__column">
      <h3 class="footer-custom__column-title">{{ section.settings.col2_title }}</h3>
      <nav class="footer-custom__nav">
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <a href="{{ link.url }}" class="footer-custom__nav-link">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="/collections/all" class="footer-custom__nav-link">Productos</a>
          <a href="/pages/nosotros" class="footer-custom__nav-link">Nosotros</a>
          <a href="/pages/contacto" class="footer-custom__nav-link">Contacto</a>
        {%- endif -%}
      </nav>
    </div>

    {%- comment -%} Column 3: Llámanos {%- endcomment -%}
    <div class="footer-custom__column">
      <h3 class="footer-custom__column-title">{{ section.settings.col3_title }}</h3>
      <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}" class="footer-custom__phone">
        {{ section.settings.phone }}
      </a>
      <p class="footer-custom__hours">{{ section.settings.hours }}</p>

      {%- comment -%} Social Icons {%- endcomment -%}
      <div class="footer-custom__social">
        {%- if section.settings.instagram_url != blank -%}
          <a
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-custom__social-link"
            aria-label="Instagram"
          >
            <img
              src="{{ 'social-instagram.svg' | asset_url }}"
              alt="Instagram"
              width="24"
              height="24"
              loading="lazy"
              class="footer-custom__social-icon"
            >
          </a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a
            href="{{ section.settings.facebook_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-custom__social-link"
            aria-label="Facebook"
          >
            <img
              src="{{ 'social-facebook.svg' | asset_url }}"
              alt="Facebook"
              width="24"
              height="24"
              loading="lazy"
              class="footer-custom__social-icon"
            >
          </a>
        {%- endif -%}
        {%- if section.settings.linkedin_url != blank -%}
          <a
            href="{{ section.settings.linkedin_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-custom__social-link"
            aria-label="LinkedIn"
          >
            <img
              src="{{ 'social-linkedin.svg' | asset_url }}"
              alt="LinkedIn"
              width="24"
              height="24"
              loading="lazy"
              class="footer-custom__social-icon"
            >
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Bottom Bar {%- endcomment -%}
  <div class="footer-custom__bottom">
    <div class="footer-custom__bottom-content">
      <div class="footer-custom__legal">
        <p class="footer-custom__copyright">{{ shop.name | upcase }} © {{ 'now' | date: '%Y' }}</p>
        <p class="footer-custom__site-by">
          SITE BY
          <a
            href="https://davidlangarica.dev?utm_source=plupack&utm_medium=referral&utm_campaign=site_credit"
            target="_blank"
            rel="noopener"
            class="footer-custom__site-by-link"
          >
            DLANGARICA
          </a>
          &amp;
          <a
            href="https://jpcabrera.dev?utm_source=plupack&utm_medium=referral&utm_campaign=site_credit"
            target="_blank"
            rel="noopener"
            class="footer-custom__site-by-link"
          >
            JPCABRERA
          </a>
        </p>
        <div class="footer-custom__asset-credits" data-asset-credits>
          <button
            type="button"
            class="footer-custom__asset-credits-trigger"
            data-asset-credits-trigger
            aria-expanded="false"
            aria-controls="asset-credits-popover-{{ section.id }}"
          >
            ASSET CREDITS
          </button>
          <div
            id="asset-credits-popover-{{ section.id }}"
            class="footer-custom__asset-credits-popover"
            data-asset-credits-popover
            role="dialog"
            aria-label="3D asset credits"
          >
            <button
              type="button"
              class="footer-custom__asset-credits-close"
              data-asset-credits-close
              aria-label="Close asset credits"
            >
              x
            </button>
            <p class="footer-custom__asset-credits-title">3D ASSETS</p>
            <p class="footer-custom__asset-credits-item">
              <a
                href="https://sketchfab.com/3d-models/latex-gloves-fallen-bd695b3f7ecf48dab7898c0a8b9a9840"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-custom__asset-credits-link"
              >
                Latex Gloves Fallen
              </a>
              by
              <a
                href="https://sketchfab.com/abdillaamy"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-custom__asset-credits-link"
              >
                abdillaamy
              </a>
            </p>
            <p class="footer-custom__asset-credits-item">
              <a
                href="https://sketchfab.com/3d-models/aluminum-tray-398c1b3b8114409a89eb02f9b42f8064"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-custom__asset-credits-link"
              >
                Aluminum tray
              </a>
              by
              <a
                href="https://sketchfab.com/extracrispi"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-custom__asset-credits-link"
              >
                Kathrin&amp;Christian
              </a>
            </p>
            <p class="footer-custom__asset-credits-license">
              Licensed under
              <a
                href="https://creativecommons.org/licenses/by/4.0/"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-custom__asset-credits-link"
              >
                CC BY 4.0
              </a>
            </p>
          </div>
        </div>
      </div>
      {%- if section.settings.terms_url != blank -%}
        <a href="{{ section.settings.terms_url }}" class="footer-custom__terms">
          {{ section.settings.terms_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% javascript %}
  (() => {
    const containers = document.querySelectorAll('[data-asset-credits]');

    containers.forEach((container) => {
      const trigger = container.querySelector('[data-asset-credits-trigger]');
      const popover = container.querySelector('[data-asset-credits-popover]');
      const close = container.querySelector('[data-asset-credits-close]');

      if (!trigger || !popover || !close) return;

      const setOpen = (isOpen) => {
        container.classList.toggle('is-open', isOpen);
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      };

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        const isOpen = container.classList.contains('is-open');
        setOpen(!isOpen);
      });

      close.addEventListener('click', (event) => {
        event.preventDefault();
        setOpen(false);
      });

      document.addEventListener('click', (event) => {
        if (!container.contains(event.target)) {
          setOpen(false);
        }
      });

      container.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(false);
          trigger.focus();
        }
      });
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .footer-custom {
    position: relative;
    width: 100%;
    background: linear-gradient(to bottom, #1e4377, #143059);
    color: white;
  }

  .footer-custom--with-noise::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: var(--footer-noise-texture);
    background-repeat: repeat;
    background-size: auto;
    opacity: 0.05;
    mix-blend-mode: soft-light;
  }

  .footer-custom--with-noise > * {
    position: relative;
    z-index: 1;
  }

  /* Logo Section */
  .footer-custom__logo-section {
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer-custom__logo-container {
    padding: 3rem 2rem;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__logo-container {
      padding: 4rem 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-custom__logo-container {
      padding: 4rem;
    }
  }

  .footer-custom__logo {
    height: 4rem;
    width: auto;
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__logo {
      height: 5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-custom__logo {
      height: 6rem;
    }
  }

  .footer-custom__logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-heading--family), sans-serif;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__logo-text {
      font-size: 1.875rem;
    }
  }

  /* Columns Grid */
  .footer-custom__columns {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  @media screen and (min-width: 750px) {
    .footer-custom__columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-custom__column {
    padding: 2rem;
    font-family: var(--font-body--family), sans-serif;
  }

  /* Mobile: add dividers between columns */
  @media screen and (max-width: 749px) {
    .footer-custom__column:not(:last-child) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
  }

  /* Desktop: add vertical dividers */
  @media screen and (min-width: 750px) {
    .footer-custom__column {
      padding: 3rem;
    }

    .footer-custom__column:not(:last-child) {
      border-right: 1px solid rgba(255, 255, 255, 0.2);
    }
  }

  @media screen and (min-width: 990px) {
    .footer-custom__column {
      padding: 4rem;
    }
  }

  .footer-custom__column-title {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.125em;
    margin-bottom: 1.5rem;
    opacity: 0.7;
    font-family: 'Roboto Mono', monospace;
  }

  /* Column 1: Address */
  .footer-custom__address {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__address {
      font-size: 1.25rem;
    }
  }

  .footer-custom__maps-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-custom__maps-link:hover {
    color: white;
  }

  .footer-custom__arrow-icon {
    display: inline-block;
    margin-left: 0.25rem;
  }

  /* Column 2: Navigation */
  .footer-custom__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-custom__nav-link {
    font-size: 1.125rem;
    font-weight: 500;
    color: white;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__nav-link {
      font-size: 1.25rem;
    }
  }

  .footer-custom__nav-link:hover {
    opacity: 0.7;
  }

  /* Column 3: Phone & Social */
  .footer-custom__phone {
    display: block;
    font-size: 1.5rem;
    font-weight: 500;
    color: white;
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: opacity 0.2s ease;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__phone {
      font-size: 1.875rem;
    }
  }

  .footer-custom__phone:hover {
    opacity: 0.7;
  }

  .footer-custom__hours {
    font-size: 0.875rem;
    opacity: 0.7;
    margin-bottom: 2rem;
  }

  .footer-custom__social {
    display: flex;
    gap: 1rem;
  }

  .footer-custom__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: opacity 0.2s ease;
  }

  .footer-custom__social-icon {
    display: block;
    width: 24px;
    height: 24px;
  }

  .footer-custom__social-link:hover {
    opacity: 0.7;
  }

  /* Bottom Bar */
  .footer-custom__bottom {
    width: 100%;
    padding: 1.5rem 2rem;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__bottom {
      padding: 1.5rem 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-custom__bottom {
      padding: 1.5rem 4rem;
    }
  }

  .footer-custom__bottom-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__bottom-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-custom__copyright {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
    font-family: 'Roboto Mono', monospace;
    margin: 0;
  }

  .footer-custom__legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12rem;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__legal {
      align-items: flex-start;
    }
  }

  .footer-custom__site-by {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.45);
    font-family: 'Roboto Mono', monospace;
    line-height: 1.1;
    margin: 0;
  }

  .footer-custom__asset-credits {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-custom__asset-credits-trigger {
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Roboto Mono', monospace;
    line-height: 1.1;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .footer-custom__asset-credits-trigger:hover,
  .footer-custom__asset-credits-trigger:focus-visible,
  .footer-custom__asset-credits.is-open .footer-custom__asset-credits-trigger {
    color: #fff;
  }

  .footer-custom__asset-credits-popover {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    width: min(320px, 86vw);
    background: rgba(20, 48, 89, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    padding: 0.8rem 0.9rem 0.75rem;
    display: none;
    z-index: 5;
  }

  .footer-custom__asset-credits:hover .footer-custom__asset-credits-popover,
  .footer-custom__asset-credits:focus-within .footer-custom__asset-credits-popover,
  .footer-custom__asset-credits.is-open .footer-custom__asset-credits-popover {
    display: block;
  }

  .footer-custom__asset-credits-title,
  .footer-custom__asset-credits-item,
  .footer-custom__asset-credits-license {
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-family: 'Roboto Mono', monospace;
    font-size: 10px;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .footer-custom__asset-credits-title {
    margin-bottom: 0.35rem;
    color: #fff;
    letter-spacing: 0.1em;
  }

  .footer-custom__asset-credits-item + .footer-custom__asset-credits-item {
    margin-top: 0.3rem;
  }

  .footer-custom__asset-credits-license {
    margin-top: 0.45rem;
    opacity: 0.92;
  }

  .footer-custom__asset-credits-link {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .footer-custom__asset-credits-link:hover,
  .footer-custom__asset-credits-link:focus-visible {
    opacity: 0.78;
  }

  .footer-custom__asset-credits-close {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1;
    padding: 0.1rem 0.2rem;
  }

  .footer-custom__asset-credits-close:hover,
  .footer-custom__asset-credits-close:focus-visible {
    color: #fff;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__asset-credits {
      align-items: flex-start;
    }

    .footer-custom__asset-credits-popover {
      left: 0;
      transform: none;
    }
  }

  .footer-custom__site-by-link {
    color: rgba(255, 255, 255, 0.45) !important;
    text-decoration: none;
    transition: opacity 0.2s ease;
    opacity: 1;
  }

  .footer-custom__site-by-link:visited {
    color: rgba(255, 255, 255, 0.45) !important;
  }

  .footer-custom__site-by-link:hover {
    color: #fff !important;
    opacity: 1;
  }

  .footer-custom__site-by-link:focus-visible,
  .footer-custom__site-by-link:active {
    color: #fff !important;
    opacity: 1;
  }

  .footer-custom__terms {
    font-size: 0.75rem;
    color: white;
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.2s ease;
    font-family: var(--font-body--family), sans-serif;
  }

  .footer-custom__terms:hover {
    opacity: 1;
  }
{% endstylesheet %}


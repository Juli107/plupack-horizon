{% comment %}
  React Interactive Homepage

  This section loads the full React app that powers the interactive homepage.
  All scroll animations, 3D elements, and interactive content are handled by React.

  The React app is built separately and outputs to assets/react-homepage.js

  WORKFLOW:
  1. Edit React components in /react-app/src/
  2. Run `pnpm build` in /react-app to build to assets
  3. Shopify theme dev auto-syncs the new JS file
{% endcomment %}

{% comment %}
  ============================================
  PASSING LIQUID DATA TO REACT
  ============================================
  This is the key pattern: inject Liquid variables as a global JS object
  BEFORE the React bundle loads. React reads window.SHOPIFY_DATA
{% endcomment %}

<script>
  window.SHOPIFY_DATA = {
    // Shop info
    shop: {
      name: {{ shop.name | json }},
      currency: {{ shop.currency | json }},
      domain: {{ shop.domain | json }}
    },

    // Asset URLs (for images loaded in React)
    assets: {
      noiseTexture: {{ 'noise.webp' | asset_url | json }},
      industry1: {{ 'industry-1.webp' | asset_url | json }},
      industry2: {{ 'industry-2.webp' | asset_url | json }},
      industry3: {{ 'industry-3.webp' | asset_url | json }},
      gastronomy1: {{ 'gastronomy-1.webp' | asset_url | json }},
      gastronomy2: {{ 'gastronomy-2.webp' | asset_url | json }},
      gastronomy3: {{ 'gastronomy-3.webp' | asset_url | json }},
      institution1: {{ 'institution-1.webp' | asset_url | json }},
      institution2: {{ 'institution-2.webp' | asset_url | json }},
      institution3: {{ 'institution-3.webp' | asset_url | json }},
      logoInverse: {% if settings.logo_inverse %}{{ settings.logo_inverse | image_url: width: 600 | json }}{% else %}null{% endif %},
      logo: {% if settings.logo %}{{ settings.logo | image_url: width: 600 | json }}{% else %}null{% endif %}
    },

    // Section settings (from schema below)
    settings: {
      backgroundColor: {{ section.settings.background_color | json }},
      accentColor: {{ section.settings.accent_color | json }},
      headingText: {{ section.settings.heading_text | json }},
      subheadingText: {{ section.settings.subheading_text | json }}
    },

    heroFeaturedProducts: [
      {%- capture hero_featured_handles_csv -%}
        {%- if section.settings.hero_featured_product_1 != blank -%}{{ section.settings.hero_featured_product_1 }},{%- endif -%}
        {%- if section.settings.hero_featured_product_2 != blank -%}{{ section.settings.hero_featured_product_2 }},{%- endif -%}
        {%- if section.settings.hero_featured_product_3 != blank -%}{{ section.settings.hero_featured_product_3 }},{%- endif -%}
        {%- if section.settings.hero_featured_product_4 != blank -%}{{ section.settings.hero_featured_product_4 }},{%- endif -%}
      {%- endcapture -%}
      {%- assign hero_featured_handles = hero_featured_handles_csv | split: ',' -%}

      {%- assign hero_first_item = true -%}
      {%- assign hero_selected_count = 0 -%}
      {%- assign hero_seen_product_ids = '|' -%}

      {%- for product_handle in hero_featured_handles -%}
        {%- if product_handle == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- if hero_selected_count >= 4 -%}
          {%- break -%}
        {%- endif -%}
        {%- assign selected_product = all_products[product_handle] -%}
        {%- if selected_product == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign selected_product_token = '|' | append: selected_product.id | append: '|' -%}
        {%- if hero_seen_product_ids contains selected_product_token -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign hero_seen_product_ids = hero_seen_product_ids | append: selected_product_token -%}
        {%- unless hero_first_item -%},{%- endunless -%}
        {
          title: {{ selected_product.title | json }},
          handle: {{ selected_product.handle | json }},
          url: {{ selected_product.url | json }},
          image: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          price: {{ selected_product.price | money | json }},
          description: {{ selected_product.description | strip_html | strip_newlines | truncate: 130 | json }}
        }
        {%- assign hero_first_item = false -%}
        {%- assign hero_selected_count = hero_selected_count | plus: 1 -%}
      {%- endfor -%}

      {%- if hero_selected_count < 4 -%}
        {%- for fallback_product in collections.all.products -%}
          {%- if hero_selected_count >= 4 -%}
            {%- break -%}
          {%- endif -%}
          {%- assign fallback_product_token = '|' | append: fallback_product.id | append: '|' -%}
          {%- if hero_seen_product_ids contains fallback_product_token -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign hero_seen_product_ids = hero_seen_product_ids | append: fallback_product_token -%}
          {%- unless hero_first_item -%},{%- endunless -%}
          {
            title: {{ fallback_product.title | json }},
            handle: {{ fallback_product.handle | json }},
            url: {{ fallback_product.url | json }},
            image: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
            price: {{ fallback_product.price | money | json }},
            description: {{ fallback_product.description | strip_html | strip_newlines | truncate: 130 | json }}
          }
          {%- assign hero_first_item = false -%}
          {%- assign hero_selected_count = hero_selected_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    ],

    // Stock Section settings and images
    stockSection: {
      title: {{ section.settings.stock_section_title | json }},
      buttonText: {{ section.settings.stock_section_button_text | json }},
      buttonUrl: {{ section.settings.stock_section_button_url | json }},
      productCount: {{ section.settings.stock_product_count | default: 170 | json }},
      rainImageCount: {{ section.settings.stock_rain_image_count | default: 24 | json }},
      // Deterministic image list from all available collections
      productImages: [
        {%- assign max_images = section.settings.stock_rain_image_count | default: 24 -%}
        {%- assign shown_count = 0 -%}
        {%- assign first_item = true -%}
        {%- assign seen_product_ids = '|' -%}

        {%- for collection in collections -%}
          {%- if shown_count >= max_images -%}
            {%- break -%}
          {%- endif -%}
          {%- for product in collection.products -%}
            {%- if shown_count >= max_images -%}
              {%- break -%}
            {%- endif -%}
            {%- assign product_token = '|' | append: product.id | append: '|' -%}
            {%- if seen_product_ids contains product_token -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign seen_product_ids = seen_product_ids | append: product_token -%}

            {%- if product.images != blank -%}
              {%- for product_image in product.images -%}
                {%- if shown_count >= max_images -%}
                  {%- break -%}
                {%- endif -%}
                {%- unless first_item -%},{%- endunless -%}
                { src: {{ product_image | image_url: width: 300 | json }}, alt: {{ product.title | json }} }
                {%- assign first_item = false -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
              {%- endfor -%}
            {%- elsif product.featured_image != blank -%}
              {%- unless first_item -%},{%- endunless -%}
              { src: {{ product.featured_image | image_url: width: 300 | json }}, alt: {{ product.title | json }} }
              {%- assign first_item = false -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- if shown_count < max_images -%}
          {%- for product in collections.all.products -%}
            {%- if shown_count >= max_images -%}
              {%- break -%}
            {%- endif -%}
            {%- assign product_token = '|' | append: product.id | append: '|' -%}
            {%- if seen_product_ids contains product_token -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign seen_product_ids = seen_product_ids | append: product_token -%}

            {%- if product.images != blank -%}
              {%- for product_image in product.images -%}
                {%- if shown_count >= max_images -%}
                  {%- break -%}
                {%- endif -%}
                {%- unless first_item -%},{%- endunless -%}
                { src: {{ product_image | image_url: width: 300 | json }}, alt: {{ product.title | json }} }
                {%- assign first_item = false -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
              {%- endfor -%}
            {%- elsif product.featured_image != blank -%}
              {%- unless first_item -%},{%- endunless -%}
              { src: {{ product.featured_image | image_url: width: 300 | json }}, alt: {{ product.title | json }} }
              {%- assign first_item = false -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    },

    productsShowcase: {
      title: {{ section.settings.products_showcase_title | json }},
      buttonText: {{ section.settings.products_showcase_button_text | json }},
      buttonUrl: {{ section.settings.products_showcase_button_url | json }},
      maxProducts: {{ section.settings.products_showcase_limit | default: 8 | json }}
    },

    products: [
      {%- assign showcase_limit = section.settings.products_showcase_limit | default: 8 -%}
      {%- assign is_first_product = true -%}
      {%- for product in collections.all.products limit: showcase_limit -%}
        {%- unless is_first_product -%},{%- endunless -%}
        {
          title: {{ product.title | json }},
          handle: {{ product.handle | json }},
          url: {{ product.url | json }},
          image: {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
          price: {{ product.price | money | json }}
        }
        {%- assign is_first_product = false -%}
      {%- endfor -%}
    ],

    // ============================================
    // THEME-WIDE SETTINGS (single source of truth)
    // These come from Theme Settings in Shopify Admin
    // ============================================
    theme: {
      // Typography - fonts are loaded by Shopify, React just uses the family names
      fonts: {
        body: {
          family: {{ settings.type_body_font.family | json }},
          fallback: {{ settings.type_body_font.fallback_families | json }},
          weight: {{ settings.type_body_font.weight | json }},
          style: {{ settings.type_body_font.style | json }}
        },
        heading: {
          family: {{ settings.type_heading_font.family | json }},
          fallback: {{ settings.type_heading_font.fallback_families | json }},
          weight: {{ settings.type_heading_font.weight | json }},
          style: {{ settings.type_heading_font.style | json }}
        },
        subheading: {
          family: {{ settings.type_subheading_font.family | json }},
          fallback: {{ settings.type_subheading_font.fallback_families | json }},
          weight: {{ settings.type_subheading_font.weight | json }},
          style: {{ settings.type_subheading_font.style | json }}
        },
        accent: {
          family: {{ settings.type_accent_font.family | json }},
          fallback: {{ settings.type_accent_font.fallback_families | json }},
          weight: {{ settings.type_accent_font.weight | json }},
          style: {{ settings.type_accent_font.style | json }}
        }
      },

      // Font sizes (from theme settings)
      fontSizes: {
        paragraph: {{ settings.type_size_paragraph | json }},
        h1: {{ settings.type_size_h1 | json }},
        h2: {{ settings.type_size_h2 | json }},
        h3: {{ settings.type_size_h3 | json }},
        h4: {{ settings.type_size_h4 | json }},
        h5: {{ settings.type_size_h5 | json }},
        h6: {{ settings.type_size_h6 | json }}
      },

      // Button styles (from active color scheme)
      buttons: {
        primary: {
          background: {{ settings.color_schemes.default.settings.primary_button_background | json }},
          text: {{ settings.color_schemes.default.settings.primary_button_text | json }},
          border: {{ settings.color_schemes.default.settings.primary_button_border | json }},
          hoverBackground: {{ settings.color_schemes.default.settings.primary_button_hover_background | json }},
          hoverText: {{ settings.color_schemes.default.settings.primary_button_hover_text | json }},
          borderRadius: {{ settings.button_border_radius | json }}
        },
        secondary: {
          background: {{ settings.color_schemes.default.settings.secondary_button_background | json }},
          text: {{ settings.color_schemes.default.settings.secondary_button_text | json }},
          border: {{ settings.color_schemes.default.settings.secondary_button_border | json }}
        }
      },

      // Colors (from active color scheme)
      colors: {
        background: {{ settings.color_schemes.default.settings.background | json }},
        foreground: {{ settings.color_schemes.default.settings.foreground | json }},
        foregroundHeading: {{ settings.color_schemes.default.settings.foreground_heading | json }},
        primary: {{ settings.color_schemes.default.settings.primary | json }},
        border: {{ settings.color_schemes.default.settings.border | json }}
      },

      // Border radius settings
      borderRadius: {
        buttons: {{ settings.button_border_radius | json }},
        inputs: {{ settings.input_border_radius | json }},
        cards: {{ settings.card_corner_radius | json }}
      }
    },

    // You can pass product data if on product page
    {% if product %}
    product: {
      title: {{ product.title | json }},
      price: {{ product.price | money_without_currency | json }},
      images: {{ product.images | map: 'src' | json }},
      handle: {{ product.handle | json }}
    },
    {% endif %}

    // You can pass collection data
    {% if collection %}
    collection: {
      title: {{ collection.title | json }},
      productsCount: {{ collection.products_count | json }}
    },
    {% endif %}

    // Customer data (if logged in)
    {% if customer %}
    customer: {
      firstName: {{ customer.first_name | json }},
      email: {{ customer.email | json }}
    },
    {% endif %}

    // Cart data
    cart: {
      itemCount: {{ cart.item_count | json }},
      totalPrice: {{ cart.total_price | money_without_currency | json }}
    },

    // Routes for navigation
    routes: {
      cart: {{ routes.cart_url | json }},
      collections: {{ routes.collections_url | json }},
      allProducts: {{ routes.all_products_collection_url | json }}
    },

    // Section ID for multiple instances
    sectionId: {{ section.id | json }}
  };
</script>

{% comment %}
  Liquid Loading Screen - Shows IMMEDIATELY before React loads
  React will hide this once it mounts its own loading screen
{% endcomment %}
<div
  id="liquid-loading-screen"
  style="
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 2147483647;
    margin: 0;
    padding: 0;
    background-color: #084e85;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  "
>
  <div
    style="
      position: absolute;
      bottom: 32px;
      left: 32px;
      font-size: 128px;
      font-weight: 300;
      letter-spacing: -0.05em;
      line-height: 1;
      color: #ffffff;
      font-family: system-ui, -apple-system, sans-serif;
    "
  >
    0%
  </div>
</div>

<style>
  /* Critical CSS for React loading screen */
  .plupack-loading-screen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    z-index: 2147483647 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide Liquid loading screen once React takes over */
  .react-loaded #liquid-loading-screen {
    display: none !important;
  }

  @media (max-width: 768px) {
    #liquid-loading-screen > div {
      font-size: 64px !important;
      bottom: 24px !important;
      left: 24px !important;
    }
  }
</style>

{% comment %} Mount point for React app {% endcomment %}
<div
  id="react-homepage"
  class="react-homepage"
  data-section-id="{{ section.id }}"
></div>

{% comment %} Load Tailwind CSS (built from react-app/) {% endcomment %}
<link rel="stylesheet" href="{{ 'react-homepage.css' | asset_url }}">

{% comment %} Load React bundle (built from react-app/) {% endcomment %}
<script src="{{ 'react-homepage.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  /*
    The React app controls the entire homepage experience.
    Lenis handles smooth scrolling, GSAP handles animations.
    We just need to ensure the container doesn't interfere.
  */
  .react-homepage {
    width: 100%;
    position: relative;
    /* React controls height through its sections */
  }

  /* Ensure canvas fills its container */
  .react-homepage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Reset any default Shopify section padding/margin that might interfere */
  .react-homepage-section {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Override Shopify's transparent header offset for this section */
  .react-homepage-section .spacing-style,
  .react-homepage-section.spacing-style {
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
    padding-top: 0 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "React Homepage",
  "tag": "section",
  "class": "react-homepage-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#084e85"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "product",
      "id": "hero_featured_product_1",
      "label": "Hero featured product 1"
    },
    {
      "type": "product",
      "id": "hero_featured_product_2",
      "label": "Hero featured product 2"
    },
    {
      "type": "product",
      "id": "hero_featured_product_3",
      "label": "Hero featured product 3"
    },
    {
      "type": "product",
      "id": "hero_featured_product_4",
      "label": "Hero featured product 4"
    },
    {
      "type": "header",
      "content": "Stock Section"
    },
    {
      "type": "text",
      "id": "stock_section_title",
      "label": "Stock Section Title",
      "default": "+200 PRODUCTOS EN STOCK PERMANENTE"
    },
    {
      "type": "range",
      "id": "stock_product_count",
      "label": "Number displayed in title",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "stock_rain_image_count",
      "label": "Rain image count",
      "min": 8,
      "max": 42,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "stock_section_button_text",
      "label": "Button Text",
      "default": "VER CATÁLOGO"
    },
    {
      "type": "url",
      "id": "stock_section_button_url",
      "label": "Button URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Products Showcase Section"
    },
    {
      "type": "text",
      "id": "products_showcase_title",
      "label": "Title",
      "default": "Explora productos para tu operación"
    },
    {
      "type": "range",
      "id": "products_showcase_limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "products_showcase_button_text",
      "label": "Button text",
      "default": "Ver más"
    },
    {
      "type": "url",
      "id": "products_showcase_button_url",
      "label": "Button URL",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "React Homepage"
    }
  ]
}
{% endschema %}

{% comment %}
  React Interactive Homepage

  This section loads the full React app that powers the interactive homepage.
  All scroll animations, 3D elements, and interactive content are handled by React.

  The React app is built separately and outputs to assets/react-homepage.js

  WORKFLOW:
  1. Edit React components in /react-app/src/
  2. Run `pnpm build` in /react-app to build to assets
  3. Shopify theme dev auto-syncs the new JS file
{% endcomment %}

{%- assign hero_lcp_product = blank -%}

{%- assign hero_slot_1 = section.settings.hero_featured_product_1 -%}
{%- assign hero_slot_2 = section.settings.hero_featured_product_2 -%}
{%- assign hero_slot_3 = section.settings.hero_featured_product_3 -%}
{%- assign hero_slot_4 = section.settings.hero_featured_product_4 -%}

{%- if hero_slot_1 != blank -%}
  {%- assign candidate = all_products[hero_slot_1] -%}
  {%- if candidate != blank and candidate.featured_image != blank -%}
    {%- assign hero_lcp_product = candidate -%}
  {%- endif -%}
{%- endif -%}

{%- if hero_lcp_product == blank and hero_slot_2 != blank -%}
  {%- assign candidate = all_products[hero_slot_2] -%}
  {%- if candidate != blank and candidate.featured_image != blank -%}
    {%- assign hero_lcp_product = candidate -%}
  {%- endif -%}
{%- endif -%}

{%- if hero_lcp_product == blank and hero_slot_3 != blank -%}
  {%- assign candidate = all_products[hero_slot_3] -%}
  {%- if candidate != blank and candidate.featured_image != blank -%}
    {%- assign hero_lcp_product = candidate -%}
  {%- endif -%}
{%- endif -%}

{%- if hero_lcp_product == blank and hero_slot_4 != blank -%}
  {%- assign candidate = all_products[hero_slot_4] -%}
  {%- if candidate != blank and candidate.featured_image != blank -%}
    {%- assign hero_lcp_product = candidate -%}
  {%- endif -%}
{%- endif -%}

{%- if hero_lcp_product == blank -%}
  {%- for fallback_product in collections.all.products -%}
    {%- if fallback_product.featured_image == blank -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign hero_lcp_product = fallback_product -%}
    {%- break -%}
  {%- endfor -%}
{%- endif -%}

{%- if hero_lcp_product != blank and hero_lcp_product.featured_image != blank -%}
  {%- assign hero_lcp_image_640 = hero_lcp_product.featured_image | image_url: width: 640 -%}
  {%- assign hero_lcp_image_960 = hero_lcp_product.featured_image | image_url: width: 960 -%}
  {%- assign hero_lcp_image_1280 = hero_lcp_product.featured_image | image_url: width: 1280 -%}
  {%- assign hero_lcp_image_1600 = hero_lcp_product.featured_image | image_url: width: 1600 -%}
  <link
    rel="preload"
    as="image"
    href="{{ hero_lcp_image_960 }}"
    imagesrcset="{{ hero_lcp_image_640 }} 640w, {{ hero_lcp_image_960 }} 960w, {{ hero_lcp_image_1280 }} 1280w, {{ hero_lcp_image_1600 }} 1600w"
    imagesizes="100vw"
    fetchpriority="high"
  >
  <img
    src="{{ hero_lcp_image_960 }}"
    srcset="{{ hero_lcp_image_640 }} 640w, {{ hero_lcp_image_960 }} 960w, {{ hero_lcp_image_1280 }} 1280w, {{ hero_lcp_image_1600 }} 1600w"
    sizes="100vw"
    width="{{ hero_lcp_product.featured_image.width }}"
    height="{{ hero_lcp_product.featured_image.height }}"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    loading="eager"
    style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;"
  >
{%- endif -%}

{% comment %}
  ============================================
  PASSING LIQUID DATA TO REACT
  ============================================
  This is the key pattern: inject Liquid variables as a global JS object
  BEFORE the React bundle loads. React reads window.SHOPIFY_DATA
{% endcomment %}

<script>
  window.SHOPIFY_DATA = {
    // Shop info
    shop: {
      name: {{ shop.name | json }},
      currency: {{ shop.currency | json }},
      domain: {{ shop.domain | json }}
    },

    // Asset URLs (for images loaded in React)
    assets: {
      noiseTexture: {{ 'noise.webp' | asset_url | json }},
      industry1: {{ 'industry-1.webp' | asset_url | json }},
      industry2: {{ 'industry-2.webp' | asset_url | json }},
      industry3: {{ 'industry-3.webp' | asset_url | json }},
      gastronomy1: {{ 'gastronomy-1.webp' | asset_url | json }},
      gastronomy2: {{ 'gastronomy-2.webp' | asset_url | json }},
      gastronomy3: {{ 'gastronomy-3.webp' | asset_url | json }},
      institution1: {{ 'institution-1.webp' | asset_url | json }},
      institution2: {{ 'institution-2.webp' | asset_url | json }},
      institution3: {{ 'institution-3.webp' | asset_url | json }},
      logoInverse: {% if settings.logo_inverse %}{{ settings.logo_inverse | image_url: width: 600 | json }}{% else %}null{% endif %},
      logo: {% if settings.logo %}{{ settings.logo | image_url: width: 600 | json }}{% else %}null{% endif %}
    },

    // Section settings (from schema below)
    settings: {
      backgroundColor: {{ section.settings.background_color | json }},
      accentColor: {{ section.settings.accent_color | json }},
      headingText: {{ section.settings.heading_text | json }},
      subheadingText: {{ section.settings.subheading_text | json }}
    },

    heroFeaturedProducts: [
      {%- assign hero_first_item = true -%}
      {%- assign hero_selected_count = 0 -%}
      {%- assign hero_seen_product_ids = '|' -%}

      {%- for slot_index in (1..4) -%}
        {%- if hero_selected_count >= 4 -%}
          {%- break -%}
        {%- endif -%}

        {%- assign selected_product_handle = blank -%}
        {%- assign hero_title_override = blank -%}
        {%- assign hero_description_override = blank -%}

        {%- case slot_index -%}
          {%- when 1 -%}
            {%- assign selected_product_handle = section.settings.hero_featured_product_1 -%}
            {%- assign hero_title_override = section.settings.hero_featured_product_1_title_override -%}
            {%- assign hero_description_override = section.settings.hero_featured_product_1_description_override -%}
          {%- when 2 -%}
            {%- assign selected_product_handle = section.settings.hero_featured_product_2 -%}
            {%- assign hero_title_override = section.settings.hero_featured_product_2_title_override -%}
            {%- assign hero_description_override = section.settings.hero_featured_product_2_description_override -%}
          {%- when 3 -%}
            {%- assign selected_product_handle = section.settings.hero_featured_product_3 -%}
            {%- assign hero_title_override = section.settings.hero_featured_product_3_title_override -%}
            {%- assign hero_description_override = section.settings.hero_featured_product_3_description_override -%}
          {%- when 4 -%}
            {%- assign selected_product_handle = section.settings.hero_featured_product_4 -%}
            {%- assign hero_title_override = section.settings.hero_featured_product_4_title_override -%}
            {%- assign hero_description_override = section.settings.hero_featured_product_4_description_override -%}
        {%- endcase -%}

        {%- if selected_product_handle == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign selected_product = all_products[selected_product_handle] -%}
        {%- if selected_product == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign selected_product_token = '|' | append: selected_product.id | append: '|' -%}
        {%- if hero_seen_product_ids contains selected_product_token -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign hero_seen_product_ids = hero_seen_product_ids | append: selected_product_token -%}
        {%- unless hero_first_item -%},{%- endunless -%}
        {
          title: {% if hero_title_override != blank %}{{ hero_title_override | strip | json }}{% else %}{{ selected_product.title | json }}{% endif %},
          handle: {{ selected_product.handle | json }},
          url: {{ selected_product.url | json }},
          image: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          image640: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 640 | json }}{% else %}null{% endif %},
          image960: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 960 | json }}{% else %}null{% endif %},
          image1200: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          image1600: {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
          imageWidth: {% if selected_product.featured_image %}{{ selected_product.featured_image.width | json }}{% else %}null{% endif %},
          imageHeight: {% if selected_product.featured_image %}{{ selected_product.featured_image.height | json }}{% else %}null{% endif %},
          price: {{ selected_product.price | money | json }},
          description: {% if hero_description_override != blank %}{{ hero_description_override | strip | strip_newlines | truncate: 130 | json }}{% else %}{{ selected_product.description | strip_html | strip_newlines | truncate: 130 | json }}{% endif %}
        }
        {%- assign hero_first_item = false -%}
        {%- assign hero_selected_count = hero_selected_count | plus: 1 -%}
      {%- endfor -%}

      {%- if hero_selected_count < 4 -%}
        {%- for fallback_product in collections.all.products -%}
          {%- if hero_selected_count >= 4 -%}
            {%- break -%}
          {%- endif -%}
          {%- if fallback_product.featured_image == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign fallback_product_token = '|' | append: fallback_product.id | append: '|' -%}
          {%- if hero_seen_product_ids contains fallback_product_token -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign hero_seen_product_ids = hero_seen_product_ids | append: fallback_product_token -%}
          {%- unless hero_first_item -%},{%- endunless -%}
          {
            title: {{ fallback_product.title | json }},
            handle: {{ fallback_product.handle | json }},
            url: {{ fallback_product.url | json }},
            image: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
            image640: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 640 | json }}{% else %}null{% endif %},
            image960: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 960 | json }}{% else %}null{% endif %},
            image1200: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
            image1600: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
            imageWidth: {% if fallback_product.featured_image %}{{ fallback_product.featured_image.width | json }}{% else %}null{% endif %},
            imageHeight: {% if fallback_product.featured_image %}{{ fallback_product.featured_image.height | json }}{% else %}null{% endif %},
            price: {{ fallback_product.price | money | json }},
            description: {{ fallback_product.description | strip_html | strip_newlines | truncate: 130 | json }}
          }
          {%- assign hero_first_item = false -%}
          {%- assign hero_selected_count = hero_selected_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    ],

    // Stock Section settings and images
    stockSection: {
      title: {{ section.settings.stock_section_title | json }},
      buttonText: {{ section.settings.stock_section_button_text | json }},
      buttonUrl: {{ section.settings.stock_section_button_url | json }},
      productCount: {{ section.settings.stock_product_count | default: 170 | json }}
    },

    productsShowcase: {
      title: {{ section.settings.products_showcase_title | json }},
      buttonText: {{ section.settings.products_showcase_button_text | json }},
      buttonUrl: {{ section.settings.products_showcase_button_url | json }},
      maxProducts: 8
    },

    products: [
      {%- assign showcase_limit = 8 -%}
      {%- assign showcase_first_item = true -%}
      {%- assign showcase_selected_count = 0 -%}
      {%- assign showcase_seen_product_ids = '|' -%}

      {%- for slot_index in (1..8) -%}
        {%- if showcase_selected_count >= showcase_limit -%}
          {%- break -%}
        {%- endif -%}

        {%- assign showcase_selected_product_handle = blank -%}
        {%- case slot_index -%}
          {%- when 1 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_1 -%}
          {%- when 2 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_2 -%}
          {%- when 3 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_3 -%}
          {%- when 4 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_4 -%}
          {%- when 5 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_5 -%}
          {%- when 6 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_6 -%}
          {%- when 7 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_7 -%}
          {%- when 8 -%}
            {%- assign showcase_selected_product_handle = section.settings.products_showcase_product_8 -%}
        {%- endcase -%}

        {%- if showcase_selected_product_handle == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign showcase_selected_product = all_products[showcase_selected_product_handle] -%}
        {%- if showcase_selected_product == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign showcase_selected_product_token = '|' | append: showcase_selected_product.id | append: '|' -%}
        {%- if showcase_seen_product_ids contains showcase_selected_product_token -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign showcase_seen_product_ids = showcase_seen_product_ids | append: showcase_selected_product_token -%}
        {%- assign showcase_available_variants_count = showcase_selected_product.variants | where: 'available', true | size -%}
        {%- assign showcase_is_available = false -%}
        {%- if showcase_available_variants_count > 0 or showcase_selected_product.available -%}
          {%- assign showcase_is_available = true -%}
        {%- endif -%}
        {%- unless showcase_first_item -%},{%- endunless -%}
        {
          title: {{ showcase_selected_product.title | json }},
          handle: {{ showcase_selected_product.handle | json }},
          url: {{ showcase_selected_product.url | json }},
          image: {% if showcase_selected_product.featured_image %}{{ showcase_selected_product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
          price: {{ showcase_selected_product.price | money | json }},
          inStock: {% if showcase_is_available %}true{% else %}false{% endif %}
        }
        {%- assign showcase_first_item = false -%}
        {%- assign showcase_selected_count = showcase_selected_count | plus: 1 -%}
      {%- endfor -%}

      {%- if showcase_selected_count < showcase_limit -%}
        {%- for fallback_product in collections.all.products -%}
          {%- if showcase_selected_count >= showcase_limit -%}
            {%- break -%}
          {%- endif -%}

          {%- assign fallback_product_token = '|' | append: fallback_product.id | append: '|' -%}
          {%- if showcase_seen_product_ids contains fallback_product_token -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign showcase_seen_product_ids = showcase_seen_product_ids | append: fallback_product_token -%}
          {%- assign fallback_available_variants_count = fallback_product.variants | where: 'available', true | size -%}
          {%- assign fallback_is_available = false -%}
          {%- if fallback_available_variants_count > 0 or fallback_product.available -%}
            {%- assign fallback_is_available = true -%}
          {%- endif -%}
          {%- unless showcase_first_item -%},{%- endunless -%}
          {
            title: {{ fallback_product.title | json }},
            handle: {{ fallback_product.handle | json }},
            url: {{ fallback_product.url | json }},
            image: {% if fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
            price: {{ fallback_product.price | money | json }},
            inStock: {% if fallback_is_available %}true{% else %}false{% endif %}
          }
          {%- assign showcase_first_item = false -%}
          {%- assign showcase_selected_count = showcase_selected_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    ],

    // ============================================
    // THEME-WIDE SETTINGS (single source of truth)
    // These come from Theme Settings in Shopify Admin
    // ============================================
    theme: {
      // Typography - fonts are loaded by Shopify, React just uses the family names
      fonts: {
        body: {
          family: {{ settings.type_body_font.family | json }},
          fallback: {{ settings.type_body_font.fallback_families | json }},
          weight: {{ settings.type_body_font.weight | json }},
          style: {{ settings.type_body_font.style | json }}
        },
        heading: {
          family: {{ settings.type_heading_font.family | json }},
          fallback: {{ settings.type_heading_font.fallback_families | json }},
          weight: {{ settings.type_heading_font.weight | json }},
          style: {{ settings.type_heading_font.style | json }}
        },
        subheading: {
          family: {{ settings.type_subheading_font.family | json }},
          fallback: {{ settings.type_subheading_font.fallback_families | json }},
          weight: {{ settings.type_subheading_font.weight | json }},
          style: {{ settings.type_subheading_font.style | json }}
        },
        accent: {
          family: {{ settings.type_accent_font.family | json }},
          fallback: {{ settings.type_accent_font.fallback_families | json }},
          weight: {{ settings.type_accent_font.weight | json }},
          style: {{ settings.type_accent_font.style | json }}
        }
      },

      // Font sizes (from theme settings)
      fontSizes: {
        paragraph: {{ settings.type_size_paragraph | json }},
        h1: {{ settings.type_size_h1 | json }},
        h2: {{ settings.type_size_h2 | json }},
        h3: {{ settings.type_size_h3 | json }},
        h4: {{ settings.type_size_h4 | json }},
        h5: {{ settings.type_size_h5 | json }},
        h6: {{ settings.type_size_h6 | json }}
      },

      // Button styles (from active color scheme)
      buttons: {
        primary: {
          background: {{ settings.color_schemes.default.settings.primary_button_background | json }},
          text: {{ settings.color_schemes.default.settings.primary_button_text | json }},
          border: {{ settings.color_schemes.default.settings.primary_button_border | json }},
          hoverBackground: {{ settings.color_schemes.default.settings.primary_button_hover_background | json }},
          hoverText: {{ settings.color_schemes.default.settings.primary_button_hover_text | json }},
          borderRadius: {{ settings.button_border_radius | json }}
        },
        secondary: {
          background: {{ settings.color_schemes.default.settings.secondary_button_background | json }},
          text: {{ settings.color_schemes.default.settings.secondary_button_text | json }},
          border: {{ settings.color_schemes.default.settings.secondary_button_border | json }}
        }
      },

      // Colors (from active color scheme)
      colors: {
        background: {{ settings.color_schemes.default.settings.background | json }},
        foreground: {{ settings.color_schemes.default.settings.foreground | json }},
        foregroundHeading: {{ settings.color_schemes.default.settings.foreground_heading | json }},
        primary: {{ settings.color_schemes.default.settings.primary | json }},
        border: {{ settings.color_schemes.default.settings.border | json }}
      },

      // Border radius settings
      borderRadius: {
        buttons: {{ settings.button_border_radius | json }},
        inputs: {{ settings.input_border_radius | json }},
        cards: {{ settings.card_corner_radius | json }}
      }
    },

    // You can pass product data if on product page
    {% if product %}
    product: {
      title: {{ product.title | json }},
      price: {{ product.price | money_without_currency | json }},
      images: {{ product.images | map: 'src' | json }},
      handle: {{ product.handle | json }}
    },
    {% endif %}

    // You can pass collection data
    {% if collection %}
    collection: {
      title: {{ collection.title | json }},
      productsCount: {{ collection.products_count | json }}
    },
    {% endif %}

    // Customer data (if logged in)
    {% if customer %}
    customer: {
      firstName: {{ customer.first_name | json }},
      email: {{ customer.email | json }}
    },
    {% endif %}

    // Cart data
    cart: {
      itemCount: {{ cart.item_count | json }},
      totalPrice: {{ cart.total_price | money_without_currency | json }}
    },

    // Routes for navigation
    routes: {
      cart: {{ routes.cart_url | json }},
      collections: {{ routes.collections_url | json }},
      allProducts: {{ routes.all_products_collection_url | json }}
    },

    // Section ID for multiple instances
    sectionId: {{ section.id | json }}
  };
</script>

{% comment %}
  Loading overlays intentionally disabled for homepage.
  We prioritize immediate hero paint/LCP.

  Original Liquid loading overlay kept commented for quick rollback:
  <div id="liquid-loading-screen" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100dvh; z-index: 2147483647; margin: 0; padding: 0; background-color: #084e85; display: flex; align-items: flex-end; justify-content: flex-start;">
    <div style="position: absolute; bottom: 32px; left: 32px; font-size: 128px; font-weight: 300; letter-spacing: -0.05em; line-height: 1; color: #ffffff; font-family: system-ui, -apple-system, sans-serif;">
      0%
    </div>
  </div>

  <style>
    .plupack-loading-screen {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: 100dvh !important;
      z-index: 2147483647 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .react-loaded #liquid-loading-screen {
      display: none !important;
    }

    @media (max-width: 768px) {
      #liquid-loading-screen > div {
        font-size: 64px !important;
        bottom: 24px !important;
        left: 24px !important;
      }
    }
  </style>
{% endcomment %}

{% comment %} Mount point for React app {% endcomment %}
<div
  id="react-homepage"
  class="react-homepage"
  data-section-id="{{ section.id }}"
  style="min-height: 100vh;"
></div>

{% comment %} Load Tailwind CSS (built from react-app/) {% endcomment %}
<link rel="stylesheet" href="{{ 'react-homepage.css' | asset_url }}">

{% comment %} Discover React module earlier for faster hydration {% endcomment %}
<link rel="modulepreload" href="{{ 'react-homepage.js' | asset_url }}">

{% comment %} Load React bundle (built from react-app/) {% endcomment %}
<script src="{{ 'react-homepage.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  /*
    The React app controls the entire homepage experience.
    Lenis handles smooth scrolling, GSAP handles animations.
    We just need to ensure the container doesn't interfere.
  */
  .react-homepage {
    width: 100%;
    position: relative;
  }

  /* Ensure canvas fills its container */
  .react-homepage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Reset any default Shopify section padding/margin that might interfere */
  .react-homepage-section {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Override Shopify's transparent header offset for this section */
  .react-homepage-section .spacing-style,
  .react-homepage-section.spacing-style {
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
    padding-top: 0 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "React Homepage",
  "tag": "section",
  "class": "react-homepage-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#084e85"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ffffff"
